@page "/consistency"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using RuleManager.Core.Domain
@using RuleManager.Data
@using RuleManager.Data.Services
@inject IDbContextFactory<RuleManagerDbContext> DbFactory
@inject WorkspaceService Workspace
@inject NavigationManager Navigation

<PageTitle>Consistency</PageTitle>

<h1>Consistency</h1>
<p class="text-muted">Review the Rule Sets and rules currently expected for each client.</p>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-lg-6">
                <label class="form-label">Search clients</label>
                <input class="form-control"
                       @bind="searchText"
                       @bind:event="oninput"
                       placeholder="Client name..." />
            </div>

            <div class="col-md-4 col-lg-3">
                <label class="form-label">Overall</label>
                <select class="form-select" @bind="overallFilter">
                    <option value="all">All clients</option>
                    <option value="aligned">Aligned</option>
                    <option value="review">Needs review</option>
                    <option value="none">No rules selected</option>
                </select>
            </div>

            <div class="col-md-4 col-lg-3">
                <label class="form-label">Rule Sets</label>
                <select class="form-select" @bind="ruleSetFilter">
                    <option value="all">All</option>
                    <option value="with">Has Rule Set</option>
                    <option value="without">No Rule Set</option>
                </select>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted small">
                Showing @FilteredRows.Count() of @rows.Count client(s)
            </div>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">Clear Filters</button>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (rows.Count == 0)
        {
            <div class="p-4 text-muted">No active clients have been added yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Rule Sets</th>
                            <th>Expected Rules</th>
                            <th>Inherited</th>
                            <th>Direct Rules</th>
                            <th>Overall</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in FilteredRows)
                        {
                            <tr>
                                <td><strong>@row.ClientName</strong></td>
                                <td>@row.RuleSetCount</td>
                                <td>@row.ExpectedRuleCount</td>
                                <td>@row.InheritedRuleCount</td>
                                <td>@row.DirectRuleCount</td>
                                <td>
                                    @if (row.ExpectedRuleCount == 0)
                                    {
                                        <span class="badge consistency-none">No rules selected</span>
                                    }
                                    else if (row.MissingAssignmentCount == 0)
                                    {
                                        <span class="badge consistency-aligned">Aligned</span>
                                    }
                                    else
                                    {
                                        <span class="badge consistency-issues">Needs review</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => OpenClientRules(row.ClientId)">
                                        Review
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private readonly List<ConsistencyRow> rows = new();
    private string searchText = string.Empty;
    private string overallFilter = "all";
    private string ruleSetFilter = "all";

    private IEnumerable<ConsistencyRow> FilteredRows => rows.Where(row =>
        MatchesSearch(row)
        && MatchesOverall(row)
        && MatchesRuleSetFilter(row));

    protected override async Task OnInitializedAsync()
    {
        var organizationId = await Workspace.GetOrCreateDefaultOrganizationIdAsync();
        await using var db = await DbFactory.CreateDbContextAsync();

        var clients = await db.Clients
            .Where(x => x.OrganizationId == organizationId && x.IsActive)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync();

        var clientIds = clients.Select(x => x.Id).ToArray();

        var setAssignments = await db.ClientRuleSetAssignments
            .Where(x => clientIds.Contains(x.ClientId))
            .AsNoTracking()
            .ToListAsync();

        var allAssignedSetIds = setAssignments.Select(x => x.RuleSetId).Distinct().ToArray();

        var setRules = await db.RuleSetRules
            .Where(x => allAssignedSetIds.Contains(x.RuleSetId))
            .AsNoTracking()
            .ToListAsync();

        var assignments = await db.ClientRuleAssignments
            .Where(x => clientIds.Contains(x.ClientId))
            .AsNoTracking()
            .ToListAsync();

        rows.Clear();

        foreach (var client in clients)
        {
            var clientSetIds = setAssignments
                .Where(x => x.ClientId == client.Id)
                .Select(x => x.RuleSetId)
                .ToHashSet();

            var inheritedRuleIds = setRules
                .Where(x => clientSetIds.Contains(x.RuleSetId))
                .Select(x => x.MasterRuleId)
                .Distinct()
                .ToArray();

            var clientAssignments = assignments
                .Where(x => x.ClientId == client.Id)
                .ToArray();

            var directRuleIds = clientAssignments
                .Where(x => x.IsExplicit)
                .Select(x => x.MasterRuleId)
                .Distinct()
                .ToArray();

            var expectedRuleIds = inheritedRuleIds
                .Concat(directRuleIds)
                .Distinct()
                .ToArray();

            var assignedRuleIds = clientAssignments
                .Select(x => x.MasterRuleId)
                .ToHashSet();

            var missingAssignmentCount = expectedRuleIds.Count(x => !assignedRuleIds.Contains(x));

            rows.Add(new ConsistencyRow(
                client.Id,
                client.Name,
                clientSetIds.Count,
                expectedRuleIds.Length,
                inheritedRuleIds.Length,
                directRuleIds.Length,
                missingAssignmentCount));
        }
    }

    private bool MatchesSearch(ConsistencyRow row)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return true;

        return row.ClientName.Contains(
            searchText.Trim(),
            StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesOverall(ConsistencyRow row) => overallFilter switch
    {
        "aligned" => row.ExpectedRuleCount > 0 && row.MissingAssignmentCount == 0,
        "review" => row.ExpectedRuleCount > 0 && row.MissingAssignmentCount > 0,
        "none" => row.ExpectedRuleCount == 0,
        _ => true
    };

    private bool MatchesRuleSetFilter(ConsistencyRow row) => ruleSetFilter switch
    {
        "with" => row.RuleSetCount > 0,
        "without" => row.RuleSetCount == 0,
        _ => true
    };

    private void ClearFilters()
    {
        searchText = string.Empty;
        overallFilter = "all";
        ruleSetFilter = "all";
    }

    private void OpenClientRules(Guid clientId) =>
        Navigation.NavigateTo($"/clients/{clientId}/rules");

    private sealed record ConsistencyRow(
        Guid ClientId,
        string ClientName,
        int RuleSetCount,
        int ExpectedRuleCount,
        int InheritedRuleCount,
        int DirectRuleCount,
        int MissingAssignmentCount);
}
