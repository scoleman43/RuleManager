@page "/consistency"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using RuleManager.Core.Domain
@using RuleManager.Core.Rules
@using RuleManager.Data
@using RuleManager.Data.Services
@inject IDbContextFactory<RuleManagerDbContext> DbFactory
@inject WorkspaceService Workspace
@inject NavigationManager Navigation

<PageTitle>Consistency</PageTitle>

<h1>Consistency</h1>
<p class="text-muted">Compare each client against the Rule Sets and individual rules they are expected to use.</p>

<div class="card">
    <div class="card-body p-0">
        @if (rows.Count == 0)
        {
            <div class="p-4 text-muted">No active clients have been added yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Rule Sets</th>
                            <th>Expected</th>
                            <th>Inherited</th>
                            <th>Overridden</th>
                            <th>Missing</th>
                            <th>Conflict</th>
                            <th>Overall</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr>
                                <td><strong>@row.ClientName</strong></td>
                                <td>@row.RuleSetCount</td>
                                <td>@row.Summary.Total</td>
                                <td>@row.Summary.Inherited</td>
                                <td>@row.Summary.Overridden</td>
                                <td>@row.Summary.Missing</td>
                                <td>@row.Summary.Conflict</td>
                                <td>
                                    @if (row.Summary.Total == 0)
                                    {
                                        <span class="badge consistency-none">No rules selected</span>
                                    }
                                    else if (row.Summary.Issues == 0)
                                    {
                                        <span class="badge consistency-aligned">Aligned</span>
                                    }
                                    else
                                    {
                                        <span class="badge consistency-issues">@row.Summary.Issues issue(s)</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => OpenClientRules(row.ClientId)">
                                        Review
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private readonly List<ConsistencyRow> rows = new();

    protected override async Task OnInitializedAsync()
    {
        var organizationId = await Workspace.GetOrCreateDefaultOrganizationIdAsync();
        await using var db = await DbFactory.CreateDbContextAsync();

        var clients = await db.Clients
            .Where(x => x.OrganizationId == organizationId && x.IsActive)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync();

        var clientIds = clients.Select(x => x.Id).ToArray();

        var setAssignments = await db.ClientRuleSetAssignments
            .Where(x => clientIds.Contains(x.ClientId))
            .AsNoTracking()
            .ToListAsync();

        var allAssignedSetIds = setAssignments.Select(x => x.RuleSetId).Distinct().ToArray();

        var setRules = await db.RuleSetRules
            .Where(x => allAssignedSetIds.Contains(x.RuleSetId))
            .AsNoTracking()
            .ToListAsync();

        var assignments = await db.ClientRuleAssignments
            .Where(x => clientIds.Contains(x.ClientId))
            .AsNoTracking()
            .ToListAsync();

        rows.Clear();

        foreach (var client in clients)
        {
            var clientSetIds = setAssignments
                .Where(x => x.ClientId == client.Id)
                .Select(x => x.RuleSetId)
                .ToHashSet();

            var expectedFromSets = setRules
                .Where(x => clientSetIds.Contains(x.RuleSetId))
                .Select(x => x.MasterRuleId);

            var clientAssignments = assignments
                .Where(x => x.ClientId == client.Id)
                .ToArray();

            var explicitRuleIds = clientAssignments
                .Where(x => x.IsExplicit)
                .Select(x => x.MasterRuleId);

            var expectedRuleIds = expectedFromSets
                .Concat(explicitRuleIds)
                .Distinct()
                .ToArray();

            rows.Add(new ConsistencyRow(
                client.Id,
                client.Name,
                clientSetIds.Count,
                ConsistencyCalculator.Calculate(expectedRuleIds, clientAssignments)));
        }
    }

    private void OpenClientRules(Guid clientId) =>
        Navigation.NavigateTo($"/clients/{clientId}/rules");

    private sealed record ConsistencyRow(
        Guid ClientId,
        string ClientName,
        int RuleSetCount,
        ConsistencySummary Summary);
}
