@page "/clients"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using RuleManager.Core.Domain
@using RuleManager.Data
@using RuleManager.Data.Services
@using Microsoft.JSInterop
@inject IDbContextFactory<RuleManagerDbContext> DbFactory
@inject WorkspaceService Workspace
@inject ClientCloneService ClientClone
@inject QuickBooksChartOfAccountsExportService ChartOfAccountsExport
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Clients</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Clients</h1>
        <p class="text-muted mb-0">Manage QuickBooks client companies and their rule libraries.</p>
    </div>
    <button class="btn btn-primary" @onclick="BeginAdd">Add Client</button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info">@message</div>
}

@if (showEditor)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(editModel.Id.HasValue ? "Edit Client" : "Add Client")</h5>
            <EditForm Model="editModel" OnValidSubmit="SaveAsync">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Client name</label>
                        <InputText class="form-control" @bind-Value="editModel.Name" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">QuickBooks company name</label>
                        <InputText class="form-control" @bind-Value="editModel.QuickBooksCompanyName" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notes</label>
                        <InputTextArea class="form-control" @bind-Value="editModel.Notes" />
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Save</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="CancelEdit">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (showCloneEditor && cloneSource is not null)
{
    <div class="rule-modal-backdrop" @onclick="CancelClone">
        <div class="rule-modal-dialog" @onclick:stopPropagation="true">
            <div class="rule-modal-header">
                <div>
                    <div class="rule-modal-eyebrow">Clone client</div>
                    <h5 class="mb-1">@cloneSource.Name</h5>
                    <div class="text-muted small">
                        Copy this client's RuleManager configuration to a new QuickBooks company.
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelClone">Close</button>
            </div>

            <div class="rule-modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">New client name</label>
                        <input class="form-control" @bind="cloneModel.Name" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">QuickBooks company name</label>
                        <input class="form-control" @bind="cloneModel.QuickBooksCompanyName" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" @bind="cloneModel.Notes"></textarea>
                    </div>
                </div>

                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" @bind="cloneModel.CopyQuickBooksReferences" id="cloneReferences" />
                    <label class="form-check-label" for="cloneReferences">
                        Copy QuickBooks references into the new RuleManager client
                    </label>
                    <div class="form-text">
                        Copies the source client's Chart of Accounts, bank/credit-card accounts, vendors/payees, and learned references.
                        Use this when the new QBO company is intentionally configured the same way.
                    </div>
                </div>

                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" @bind="cloneModel.DownloadChartOfAccounts" id="cloneDownloadCoa" />
                    <label class="form-check-label" for="cloneDownloadCoa">
                        Create a QBO Chart of Accounts import file
                    </label>
                    <div class="form-text">
                        Downloads a CSV with Account Number, Account Name, Type, and Detail Type so the source Chart of Accounts can be imported into the new QuickBooks company.
                    </div>
                </div>

                <div class="alert alert-info mt-3 mb-0">
                    The clone copies assigned Rule Sets, direct reusable rules, export priority, client-specific rules, and client mappings.
                    QuickBooks import/change provenance is reset for the new client.
                </div>
            </div>

            <div class="rule-modal-footer">
                <button class="btn btn-outline-secondary" @onclick="CancelClone">Cancel</button>
                <button class="btn btn-primary" @onclick="CloneClientAsync" disabled="@cloneBusy">
                    @(cloneBusy ? "Cloning..." : "Clone Client")
                </button>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        @if (clients.Count == 0)
        {
            <div class="p-4 text-muted">No clients have been added yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>QuickBooks Company</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in clients)
                        {
                            <tr>
                                <td>
                                    <strong>@client.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(client.Notes))
                                    {
                                        <div class="small text-muted">@client.Notes</div>
                                    }
                                </td>
                                <td>@(client.QuickBooksCompanyName ?? "—")</td>
                                <td>
                                    <span class="badge @(client.IsActive ? "status-badge-active" : "status-badge-inactive")">
                                        @(client.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-success me-2"
                                            @onclick="() => OpenRules(client.Id)">
                                        Rules
                                    </button>
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => BeginEdit(client)">Edit</button>
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => BeginClone(client)">Clone</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleActiveAsync(client)">
                                        @(client.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private readonly List<Client> clients = new();
    private ClientEditModel editModel = new();
    private Guid organizationId;
    private bool showEditor;
    private bool showCloneEditor;
    private bool cloneBusy;
    private Client? cloneSource;
    private CloneClientEditModel cloneModel = new();
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        organizationId = await Workspace.GetOrCreateDefaultOrganizationIdAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        clients.Clear();
        clients.AddRange(await db.Clients
            .Where(x => x.OrganizationId == organizationId)
            .OrderByDescending(x => x.IsActive)
            .ThenBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());
    }

    private void BeginAdd()
    {
        editModel = new ClientEditModel();
        showEditor = true;
        message = null;
    }

    private void BeginEdit(Client client)
    {
        editModel = new ClientEditModel
        {
            Id = client.Id,
            Name = client.Name,
            QuickBooksCompanyName = client.QuickBooksCompanyName ?? string.Empty,
            Notes = client.Notes ?? string.Empty
        };
        showEditor = true;
        message = null;
    }

    private void BeginClone(Client client)
    {
        cloneSource = client;
        cloneModel = new CloneClientEditModel
        {
            Name = $"{client.Name} - Copy",
            QuickBooksCompanyName = string.Empty,
            Notes = client.Notes ?? string.Empty,
            CopyQuickBooksReferences = true,
            DownloadChartOfAccounts = true
        };
        showCloneEditor = true;
        showEditor = false;
        message = null;
    }

    private void CancelClone()
    {
        showCloneEditor = false;
        cloneSource = null;
        cloneModel = new CloneClientEditModel();
    }

    private async Task CloneClientAsync()
    {
        if (cloneSource is null || cloneBusy)
            return;

        var newName = cloneModel.Name.Trim();
        if (string.IsNullOrWhiteSpace(newName))
        {
            message = "New client name is required.";
            return;
        }

        cloneBusy = true;

        try
        {
            var result = await ClientClone.CloneAsync(
                cloneSource.Id,
                new CloneClientRequest(
                    newName,
                    NullIfWhiteSpace(cloneModel.QuickBooksCompanyName),
                    NullIfWhiteSpace(cloneModel.Notes),
                    cloneModel.CopyQuickBooksReferences));

            if (cloneModel.DownloadChartOfAccounts)
            {
                try
                {
                    var export = await ChartOfAccountsExport.GenerateAsync(
                        cloneSource.Id,
                        newName);

                    await using var stream = new MemoryStream(export.Content);
                    using var streamReference = new DotNetStreamReference(stream);

                    await JS.InvokeVoidAsync(
                        "downloadFileFromStream",
                        export.FileName,
                        streamReference,
                        "text/csv;charset=utf-8");
                }
                catch (InvalidOperationException)
                {
                    // The source may not have an imported Chart of Accounts.
                    // The clone itself is still valid.
                }
            }

            message =
                $"Client '{newName}' cloned: {result.RuleSetCount} Rule Set(s), " +
                $"{result.ReusableRuleCount} reusable assignment(s), " +
                $"{result.ClientSpecificRuleCount} client-specific rule(s), " +
                $"{result.ReferenceCount} QuickBooks reference(s) copied.";

            CancelClone();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            message = $"Client clone failed: {ex.Message}";
        }
        finally
        {
            cloneBusy = false;
        }
    }

    private void CancelEdit()
    {
        showEditor = false;
        editModel = new ClientEditModel();
    }

    private async Task SaveAsync()
    {
        var name = editModel.Name.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            message = "Client name is required.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        if (editModel.Id.HasValue)
        {
            var client = await db.Clients.SingleAsync(x => x.Id == editModel.Id.Value);
            client.Name = name;
            client.QuickBooksCompanyName = NullIfWhiteSpace(editModel.QuickBooksCompanyName);
            client.Notes = NullIfWhiteSpace(editModel.Notes);
            client.ModifiedUtc = DateTime.UtcNow;
        }
        else
        {
            db.Clients.Add(new Client
            {
                OrganizationId = organizationId,
                Name = name,
                QuickBooksCompanyName = NullIfWhiteSpace(editModel.QuickBooksCompanyName),
                Notes = NullIfWhiteSpace(editModel.Notes)
            });
        }

        await db.SaveChangesAsync();
        showEditor = false;
        editModel = new ClientEditModel();
        message = "Client saved.";
        await LoadAsync();
    }

    private void OpenRules(Guid clientId) =>
        Navigation.NavigateTo($"/clients/{clientId}/rules");

    private async Task ToggleActiveAsync(Client client)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Clients.SingleAsync(x => x.Id == client.Id);
        entity.IsActive = !entity.IsActive;
        entity.ModifiedUtc = DateTime.UtcNow;
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private static string? NullIfWhiteSpace(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class ClientEditModel
    {
        public Guid? Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string QuickBooksCompanyName { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
    }

    private sealed class CloneClientEditModel
    {
        public string Name { get; set; } = string.Empty;
        public string QuickBooksCompanyName { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
        public bool CopyQuickBooksReferences { get; set; } = true;
        public bool DownloadChartOfAccounts { get; set; } = true;
    }
}
