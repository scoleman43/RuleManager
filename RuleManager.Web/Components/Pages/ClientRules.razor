@page "/clients/{ClientId:guid}/rules"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using RuleManager.Core.Domain
@using RuleManager.Core.Rules
@using RuleManager.Data
@using RuleManager.Data.Services
@inject IDbContextFactory<RuleManagerDbContext> DbFactory
@inject RuleSetAssignmentService RuleSetAssignments
@inject NavigationManager Navigation

<PageTitle>Client Rules</PageTitle>

@if (client is null)
{
    <p>Loading client...</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <button class="btn btn-link p-0 mb-2" @onclick="BackToClients">← Back to Clients</button>
            <h1>@client.Name</h1>
            <p class="text-muted mb-0">Choose Rule Sets for this client, then manage individual exceptions.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success">@message</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Rule Sets</h5>
            <p class="text-muted">A new client starts with no Rule Sets selected. Selecting a set adds its Master Rules as inherited rules.</p>

            @if (ruleSets.Count == 0)
            {
                <div class="text-muted">No active Rule Sets exist yet.</div>
            }
            else
            {
                <div class="row g-2">
                    @foreach (var set in ruleSets)
                    {
                        var setId = set.Id;
                        var selected = assignedRuleSetIds.Contains(setId);
                        <div class="col-md-6 col-lg-4">
                            <div class="border rounded p-2 h-100">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           checked="@selected"
                                           @onchange="e => ToggleRuleSetAsync(setId, e)" />
                                    <label class="form-check-label">
                                        <strong>@set.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(set.Description))
                                        {
                                            <div class="small text-muted">@set.Description</div>
                                        }
                                    </label>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md"><div class="card h-100"><div class="card-body"><div class="text-muted">Expected Rules</div><div class="display-6">@summary.Total</div></div></div></div>
        <div class="col-md"><div class="card h-100"><div class="card-body"><div class="text-muted">Inherited</div><div class="display-6">@summary.Inherited</div></div></div></div>
        <div class="col-md"><div class="card h-100"><div class="card-body"><div class="text-muted">Overridden</div><div class="display-6">@summary.Overridden</div></div></div></div>
        <div class="col-md"><div class="card h-100"><div class="card-body"><div class="text-muted">Missing</div><div class="display-6">@summary.Missing</div></div></div></div>
        <div class="col-md"><div class="card h-100"><div class="card-body"><div class="text-muted">Conflict</div><div class="display-6">@summary.Conflict</div></div></div></div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            @if (masterRules.Count == 0)
            {
                <div class="p-4 text-muted">No active master rules exist yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Master Rule</th>
                                <th>Source</th>
                                <th>Transaction</th>
                                <th>Category</th>
                                <th>Assignment</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in masterRules)
                            {
                                var assignment = AssignmentFor(rule.Id);
                                var expectedBySet = expectedFromRuleSets.Contains(rule.Id);
                                <tr class="@(!expectedBySet && assignment is null ? "text-muted" : null)">
                                    <td>
                                        <strong>@rule.Name</strong>
                                        <div class="small text-muted">@(rule.Direction == RuleDirection.MoneyOut ? "Money out" : "Money in")</div>
                                    </td>
                                    <td>
                                        @if (expectedBySet)
                                        {
                                            <span class="badge text-bg-primary">Rule Set</span>
                                        }
                                        else if (assignment?.IsExplicit == true)
                                        {
                                            <span class="badge text-bg-secondary">Individual</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not selected</span>
                                        }
                                    </td>
                                    <td>@FormatTransactionType(rule.TransactionType)</td>
                                    <td>@(rule.CategoryName ?? "—")</td>
                                    <td>
                                        @if (assignment is null)
                                        {
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => AssignExplicitAsync(rule.Id)">Assign Individually</button>
                                        }
                                        else if (expectedBySet && !assignment.IsExplicit)
                                        {
                                            <span class="small text-muted">Managed by Rule Set</span>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveExplicitAssignmentAsync(assignment.Id)">Remove</button>
                                        }
                                    </td>
                                    <td>
                                        @if (assignment is null)
                                        {
                                            @if (expectedBySet)
                                            {
                                                <span class="badge text-bg-warning">Missing</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        }
                                        else
                                        {
                                            <select class="form-select form-select-sm" style="min-width: 140px"
                                                    value="@assignment.Status"
                                                    @onchange="e => ChangeStatusAsync(assignment.Id, e)">
                                                <option value="@RuleAssignmentStatus.Inherited">Inherited</option>
                                                <option value="@RuleAssignmentStatus.Overridden">Overridden</option>
                                                <option value="@RuleAssignmentStatus.Conflict">Conflict</option>
                                            </select>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid ClientId { get; set; }

    private Client? client;
    private readonly List<MasterRule> masterRules = new();
    private readonly List<RuleSet> ruleSets = new();
    private readonly List<ClientRuleAssignment> assignments = new();
    private readonly HashSet<Guid> assignedRuleSetIds = new();
    private readonly HashSet<Guid> expectedFromRuleSets = new();
    private ConsistencySummary summary = new(0, 0, 0, 0, 0);
    private string? message;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        client = await db.Clients.AsNoTracking().SingleOrDefaultAsync(x => x.Id == ClientId);
        if (client is null)
        {
            Navigation.NavigateTo("/clients");
            return;
        }

        masterRules.Clear();
        masterRules.AddRange(await db.MasterRules
            .Where(x => x.OrganizationId == client.OrganizationId && x.IsActive)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());

        ruleSets.Clear();
        ruleSets.AddRange(await db.RuleSets
            .Where(x => x.OrganizationId == client.OrganizationId && x.IsActive)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());

        assignedRuleSetIds.Clear();
        foreach (var id in await db.ClientRuleSetAssignments
            .Where(x => x.ClientId == ClientId)
            .Select(x => x.RuleSetId)
            .ToListAsync())
        {
            assignedRuleSetIds.Add(id);
        }

        expectedFromRuleSets.Clear();
        if (assignedRuleSetIds.Count > 0)
        {
            foreach (var id in await db.RuleSetRules
                .Where(x => assignedRuleSetIds.Contains(x.RuleSetId))
                .Select(x => x.MasterRuleId)
                .Distinct()
                .ToListAsync())
            {
                expectedFromRuleSets.Add(id);
            }
        }

        assignments.Clear();
        assignments.AddRange(await db.ClientRuleAssignments
            .Where(x => x.ClientId == ClientId)
            .AsNoTracking()
            .ToListAsync());

        var expectedIds = expectedFromRuleSets
            .Concat(assignments.Where(x => x.IsExplicit).Select(x => x.MasterRuleId))
            .Distinct()
            .ToArray();

        summary = ConsistencyCalculator.Calculate(expectedIds, assignments);
    }

    private void BackToClients() => Navigation.NavigateTo("/clients");

    private ClientRuleAssignment? AssignmentFor(Guid masterRuleId) =>
        assignments.FirstOrDefault(x => x.MasterRuleId == masterRuleId);

    private async Task ToggleRuleSetAsync(Guid ruleSetId, ChangeEventArgs e)
    {
        var selected = e.Value is bool value && value;

        if (selected)
        {
            await RuleSetAssignments.AssignRuleSetToClientAsync(ClientId, ruleSetId);
            message = "Rule Set assigned. Its rules are now inherited by this client.";
        }
        else
        {
            await RuleSetAssignments.RemoveRuleSetFromClientAsync(ClientId, ruleSetId);
            message = "Rule Set removed. Rules only required by that set were removed.";
        }

        await LoadAsync();
    }

    private async Task AssignExplicitAsync(Guid masterRuleId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var assignment = await db.ClientRuleAssignments
            .SingleOrDefaultAsync(x => x.ClientId == ClientId && x.MasterRuleId == masterRuleId);

        if (assignment is null)
        {
            db.ClientRuleAssignments.Add(new ClientRuleAssignment
            {
                ClientId = ClientId,
                MasterRuleId = masterRuleId,
                Status = RuleAssignmentStatus.Inherited,
                IsExplicit = true
            });
        }
        else
        {
            assignment.IsExplicit = true;
            assignment.ModifiedUtc = DateTime.UtcNow;
        }

        await db.SaveChangesAsync();
        message = "Master rule assigned individually.";
        await LoadAsync();
    }

    private async Task RemoveExplicitAssignmentAsync(Guid assignmentId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var assignment = await db.ClientRuleAssignments.SingleAsync(x => x.Id == assignmentId);

        if (expectedFromRuleSets.Contains(assignment.MasterRuleId))
        {
            assignment.IsExplicit = false;
            assignment.ModifiedUtc = DateTime.UtcNow;
            message = "Individual assignment removed. The rule remains because it is required by a selected Rule Set.";
        }
        else
        {
            db.ClientRuleAssignments.Remove(assignment);
            message = "Individual assignment removed.";
        }

        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task ChangeStatusAsync(Guid assignmentId, ChangeEventArgs e)
    {
        if (!Enum.TryParse<RuleAssignmentStatus>(e.Value?.ToString(), out var status) ||
            status is RuleAssignmentStatus.Missing or RuleAssignmentStatus.Unmanaged)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var assignment = await db.ClientRuleAssignments.SingleAsync(x => x.Id == assignmentId);
        assignment.Status = status;
        assignment.ModifiedUtc = DateTime.UtcNow;
        await db.SaveChangesAsync();

        message = $"Rule status changed to {status}.";
        await LoadAsync();
    }

    private static string FormatTransactionType(RuleTransactionType type) => type switch
    {
        RuleTransactionType.CreditCardPayment => "Credit card payment",
        _ => string.Concat(type.ToString().Select((c, i) => i > 0 && char.IsUpper(c) ? " " + c : c.ToString()))
    };
}
