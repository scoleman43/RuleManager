@page "/clients/{ClientId:guid}/rules"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using RuleManager.Core.Domain
@using RuleManager.Data
@using RuleManager.Data.Services
@inject IDbContextFactory<RuleManagerDbContext> DbFactory
@inject RuleSetAssignmentService RuleSetAssignments
@inject NavigationManager Navigation

<PageTitle>Client Rules</PageTitle>

@if (client is null)
{
    <p>Loading client...</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <button class="btn btn-link p-0 mb-2" @onclick="BackToClients">← Back to Clients</button>
            <h1>@client.Name</h1>
            <p class="text-muted mb-0">Manage the Rule Sets and individual rules assigned to this client.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success">@message</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted">Rule Sets</div>
                <div class="display-6">@assignedRuleSetIds.Count</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted">Assigned Rules</div>
                <div class="display-6">@AssignedRules.Count()</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted">From Rule Sets</div>
                <div class="display-6">@SetRuleCount</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted">Direct Rules</div>
                <div class="display-6">@DirectRuleCount</div>
            </div></div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="card-title mb-1">QuickBooks Export Order</h5>
                    <div class="text-muted small">
                        QuickBooks evaluates rules from top to bottom. This priority controls the row order in the exported workbook.
                    </div>
                </div>
            </div>

            @if (!ExportOrderRows.Any())
            {
                <div class="text-muted">No rules are currently available for export.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 105px;">Priority</th>
                                <th>Rule</th>
                                <th>Source</th>
                                <th class="text-end" style="width: 120px;">Move</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in ExportOrderRows)
                            {
                                <tr>
                                    <td>
                                        <input class="form-control form-control-sm export-priority-input"
                                               type="number"
                                               min="1"
                                               max="@ExportOrderRows.Count()"
                                               value="@row.Priority"
                                               @onchange="e => SetExportPriorityAsync(row, e)" />
                                    </td>
                                    <td><strong>@row.Name</strong></td>
                                    <td>
                                        <span class="badge @(row.IsClientSpecific ? "status-badge-client-specific" : "rule-source-set")">
                                            @row.Source
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Change export priority">
                                            <button class="btn btn-outline-secondary"
                                                    title="Move up"
                                                    disabled="@(row.Priority <= 1)"
                                                    @onclick="() => MoveExportRuleAsync(row, -1)">↑</button>
                                            <button class="btn btn-outline-secondary"
                                                    title="Move down"
                                                    disabled="@(row.Priority >= ExportOrderRows.Count())"
                                                    @onclick="() => MoveExportRuleAsync(row, 1)">↓</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <button type="button"
                class="btn text-start w-100 p-0 border-0"
                @onclick="ToggleRuleSetsSection">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-1">Assigned Rule Sets (@assignedRuleSetIds.Count)</h5>
                    <div class="text-muted small">Rule Sets automatically keep this client up to date when rules are added to the set.</div>
                </div>
                <span class="fs-4" aria-hidden="true">@(showRuleSetsSection ? "▲" : "▼")</span>
            </div>
        </button>

        @if (showRuleSetsSection)
        {
            <div class="card-body border-top">
                @if (AssignedRuleSets.Any())
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Rule Set</th>
                                    <th>Description</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var set in AssignedRuleSets)
                                {
                                    <tr>
                                        <td><strong>@set.Name</strong></td>
                                        <td>@(set.Description ?? "—")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveRuleSetAsync(set.Id)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted mb-3">No Rule Sets are assigned to this client.</div>
                }

                <div class="row g-3 align-items-end">
                    <div class="col-lg-5">
                        <label class="form-label">Find Rule Set</label>
                        <input class="form-control"
                               @bind="ruleSetSearchText"
                               @bind:event="oninput"
                               placeholder="Start typing a Rule Set name..." />
                    </div>
                    <div class="col-lg-5">
                        <label class="form-label">Rule Set</label>
                        <select class="form-select" @bind="selectedRuleSetId">
                            <option value="">-- Select Rule Set --</option>
                            @foreach (var set in AvailableRuleSetOptions)
                            {
                                <option value="@set.Id">@set.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-2">
                        <button class="btn btn-primary w-100" @onclick="AddRuleSetAsync">Add Rule Set</button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (showDirectRulePicker)
    {
        <div class="card mb-4 border-primary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="card-title mb-1">Add Direct Rule</h5>
                        <div class="text-muted">Use this for a one-off rule that should apply to this client outside of its Rule Sets.</div>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CloseDirectRulePicker">Close</button>
                </div>

                <div class="row g-3 align-items-end">
                    <div class="col-lg-5">
                        <label class="form-label">Find Rule</label>
                        <input class="form-control"
                               @bind="directRuleSearchText"
                               @bind:event="oninput"
                               placeholder="Start typing a rule name..." />
                    </div>
                    <div class="col-lg-5">
                        <label class="form-label">Rule</label>
                        <select class="form-select" @bind="selectedDirectRuleId">
                            <option value="">-- Select Rule --</option>
                            @foreach (var rule in DirectRuleOptions)
                            {
                                <option value="@rule.Id">@rule.Name — @(rule.CategoryName ?? "No category")</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-2">
                        <button class="btn btn-primary w-100" @onclick="AddDirectRuleAsync">Add</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <button type="button"
                class="btn text-start w-100 p-0 border-0"
                @onclick="ToggleAssignedRulesSection">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-1">Assigned Rules (@AssignedRules.Count())</h5>
                    <div class="text-muted small">Only rules currently assigned through a Rule Set or directly are shown.</div>
                </div>
                <span class="fs-4" aria-hidden="true">@(showAssignedRulesSection ? "▲" : "▼")</span>
            </div>
        </button>

        @if (showAssignedRulesSection)
        {
            <div class="card-body border-top">
                <div class="d-flex justify-content-end mb-3">
                    <button class="btn btn-outline-primary" @onclick="OpenDirectRulePicker">Add Direct Rule</button>
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-lg-4">
                                <label class="form-label">Search</label>
                                <input class="form-control"
                                       @bind="ruleSearchText"
                                       @bind:event="oninput"
                                       placeholder="Rule name, category, payee, or condition..." />
                            </div>
                            <div class="col-md-4 col-lg-3">
                                <label class="form-label">Source</label>
                                <select class="form-select" @bind="sourceFilter">
                                    <option value="all">All Assigned Rules</option>
                                    <option value="set">Rule Set</option>
                                    <option value="direct">Direct</option>
                                    <option value="both">Rule Set + Direct</option>
                                </select>
                            </div>
                            <div class="col-md-4 col-lg-2">
                                <label class="form-label">Direction</label>
                                <select class="form-select" @bind="directionFilter">
                                    <option value="all">All</option>
                                    <option value="out">Money out</option>
                                    <option value="in">Money in</option>
                                </select>
                            </div>
                            <div class="col-md-4 col-lg-3">
                                <label class="form-label">Category</label>
                                <select class="form-select" @bind="categoryFilter">
                                    <option value="all">All</option>
                                    <option value="none">No category</option>
                                    @foreach (var category in categoryNames)
                                    {
                                        <option value="@category">@category</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div class="text-muted small">Showing @FilteredAssignedRules.Count() of @AssignedRules.Count() assigned rule(s)</div>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearRuleFilters">Clear Filters</button>
                        </div>
                    </div>
                </div>

                @if (!FilteredAssignedRules.Any())
                {
                    <div class="text-muted">
                        @(AssignedRules.Any() ? "No assigned rules match the current search and filters." : "This client does not have any rules assigned yet.")
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Rule</th>
                                    <th>Source</th>
                                    <th>Direction</th>
                                    <th>Transaction</th>
                                    <th>Category</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rule in FilteredAssignedRules)
                                {
                                    var assignment = AssignmentFor(rule.Id);
                                    var fromSet = expectedFromRuleSets.Contains(rule.Id);
                                    var direct = assignment?.IsExplicit == true;

                                    <tr>
                                        <td>
                                            <strong>@rule.Name</strong>
                                            @if (!string.IsNullOrWhiteSpace(rule.Payee))
                                            {
                                                <div class="small text-muted">Payee: @rule.Payee</div>
                                            }
                                        </td>
                                        <td>
                                            @if (fromSet)
                                            {
                                                <span class="badge rule-source-set me-1">@RuleSetSourceText(rule.Id)</span>
                                            }
                                            @if (direct)
                                            {
                                                <span class="badge rule-source-direct">Direct</span>
                                            }
                                        </td>
                                        <td>@(rule.Direction == RuleDirection.MoneyOut ? "Money out" : "Money in")</td>
                                        <td>@FormatTransactionType(rule.TransactionType)</td>
                                        <td>@(rule.CategoryName ?? "—")</td>
                                        <td class="text-end">
                                            @if (direct)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveDirectAssignmentAsync(assignment!.Id)">
                                                    Remove Direct
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="small text-muted">Managed by Rule Set</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>

    @if (clientSpecificRules.Count > 0)
    {
        <div class="card mt-4">
            <div class="card-body">
                <h5 class="card-title mb-1">Client-Specific Imported Rules (@clientSpecificRules.Count)</h5>
                <div class="text-muted small mb-3">
                    These rules contain QuickBooks account-specific data. They belong only to this client and are preserved exactly for export.
                </div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Rule</th>
                                <th>Direction</th>
                                <th>Transaction</th>
                                <th>Account / Category</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in clientSpecificRules)
                            {
                                <tr>
                                    <td><strong>@rule.Name</strong></td>
                                    <td>@(rule.Direction == RuleDirection.MoneyOut ? "Money out" : "Money in")</td>
                                    <td>@FormatTransactionType(rule.TransactionType)</td>
                                    <td>@(rule.CategoryName ?? "—")</td>
                                    <td><span class="badge status-badge-client-specific">Client-specific</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid ClientId { get; set; }

    private Client? client;
    private readonly List<MasterRule> masterRules = new();
    private readonly List<RuleSet> ruleSets = new();
    private readonly List<RuleSetRule> ruleSetRules = new();
    private readonly List<ClientRuleAssignment> assignments = new();
    private readonly List<ClientRule> clientSpecificRules = new();
    private readonly HashSet<Guid> assignedRuleSetIds = new();
    private readonly HashSet<Guid> expectedFromRuleSets = new();
    private readonly List<string> categoryNames = new();

    private string? message;
    private bool showRuleSetsSection;
    private bool showAssignedRulesSection;

    private string ruleSetSearchText = string.Empty;
    private string selectedRuleSetId = string.Empty;

    private bool showDirectRulePicker;
    private string directRuleSearchText = string.Empty;
    private string selectedDirectRuleId = string.Empty;

    private string ruleSearchText = string.Empty;
    private string sourceFilter = "all";
    private string directionFilter = "all";
    private string categoryFilter = "all";

    private IEnumerable<RuleSet> AssignedRuleSets =>
        ruleSets.Where(x => assignedRuleSetIds.Contains(x.Id));

    private IEnumerable<RuleSet> AvailableRuleSetOptions =>
        ruleSets.Where(set =>
            !assignedRuleSetIds.Contains(set.Id)
            && (string.IsNullOrWhiteSpace(ruleSetSearchText)
                || set.Name.Contains(ruleSetSearchText.Trim(), StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<MasterRule> AssignedRules =>
        masterRules.Where(rule =>
            expectedFromRuleSets.Contains(rule.Id)
            || AssignmentFor(rule.Id)?.IsExplicit == true);

    private IEnumerable<MasterRule> FilteredAssignedRules =>
        AssignedRules.Where(rule =>
            MatchesRuleSearch(rule)
            && MatchesSource(rule)
            && MatchesDirection(rule)
            && MatchesCategory(rule))
        .OrderBy(rule => AssignmentFor(rule.Id)?.ExportPriority ?? int.MaxValue)
        .ThenBy(rule => rule.Name);

    private IEnumerable<MasterRule> DirectRuleOptions =>
        masterRules.Where(rule =>
            AssignmentFor(rule.Id)?.IsExplicit != true
            && (string.IsNullOrWhiteSpace(directRuleSearchText)
                || rule.Name.Contains(directRuleSearchText.Trim(), StringComparison.OrdinalIgnoreCase)
                || (rule.CategoryName?.Contains(directRuleSearchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                || (rule.Payee?.Contains(directRuleSearchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)));

    private IReadOnlyList<ExportOrderRow> ExportOrderRows
    {
        get
        {
            var clientSpecificNames = clientSpecificRules
                .Select(x => x.Name)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var reusableRows = assignments
                .Join(masterRules,
                    assignment => assignment.MasterRuleId,
                    rule => rule.Id,
                    (assignment, rule) => new { assignment, rule })
                .Where(x => !clientSpecificNames.Contains(x.rule.Name))
                .Select(x =>
                {
                    var fromSet = expectedFromRuleSets.Contains(x.rule.Id);
                    var direct = x.assignment.IsExplicit;
                    var source = fromSet && direct
                        ? "Rule Set + Direct"
                        : fromSet
                            ? "Rule Set"
                            : "Direct";

                    return new ExportOrderRow(
                        x.assignment.Id,
                        false,
                        x.assignment.ExportPriority,
                        x.rule.Name,
                        source);
                });

            var clientRows = clientSpecificRules.Select(rule =>
                new ExportOrderRow(
                    rule.Id,
                    true,
                    rule.ExportPriority,
                    rule.Name,
                    "Client-specific"));

            return reusableRows
                .Concat(clientRows)
                .OrderBy(x => x.Priority)
                .ThenBy(x => x.Name)
                .ToList();
        }
    }

    private int SetRuleCount => AssignedRules.Count(x => expectedFromRuleSets.Contains(x.Id));
    private int DirectRuleCount => AssignedRules.Count(x => AssignmentFor(x.Id)?.IsExplicit == true);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        client = await db.Clients.AsNoTracking().SingleOrDefaultAsync(x => x.Id == ClientId);
        if (client is null)
        {
            Navigation.NavigateTo("/clients");
            return;
        }

        masterRules.Clear();
        masterRules.AddRange(await db.MasterRules
            .Where(x => x.OrganizationId == client.OrganizationId && x.IsActive)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());

        ruleSets.Clear();
        ruleSets.AddRange(await db.RuleSets
            .Where(x => x.OrganizationId == client.OrganizationId && x.IsActive)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());

        assignedRuleSetIds.Clear();
        foreach (var id in await db.ClientRuleSetAssignments
            .Where(x => x.ClientId == ClientId)
            .Select(x => x.RuleSetId)
            .ToListAsync())
        {
            assignedRuleSetIds.Add(id);
        }

        ruleSetRules.Clear();
        var assignedSetIds = assignedRuleSetIds.ToArray();
        if (assignedSetIds.Length > 0)
        {
            ruleSetRules.AddRange(await db.RuleSetRules
                .Where(x => assignedSetIds.Contains(x.RuleSetId))
                .AsNoTracking()
                .ToListAsync());
        }

        expectedFromRuleSets.Clear();
        foreach (var id in ruleSetRules.Select(x => x.MasterRuleId).Distinct())
            expectedFromRuleSets.Add(id);

        assignments.Clear();
        assignments.AddRange(await db.ClientRuleAssignments
            .Where(x => x.ClientId == ClientId)
            .AsNoTracking()
            .ToListAsync());

        clientSpecificRules.Clear();
        clientSpecificRules.AddRange(await db.ClientRules
            .Where(x => x.ClientId == ClientId && x.IsAccountSpecific)
            .OrderBy(x => x.ExportPriority)
            .ThenBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());

        categoryNames.Clear();
        categoryNames.AddRange(AssignedRules
            .Select(x => x.CategoryName)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x));
    }

    private void BackToClients() => Navigation.NavigateTo("/clients");

    private void ToggleRuleSetsSection() => showRuleSetsSection = !showRuleSetsSection;

    private void ToggleAssignedRulesSection() => showAssignedRulesSection = !showAssignedRulesSection;

    private ClientRuleAssignment? AssignmentFor(Guid masterRuleId) =>
        assignments.FirstOrDefault(x => x.MasterRuleId == masterRuleId);

    private async Task AddRuleSetAsync()
    {
        Guid ruleSetId;

        if (Guid.TryParse(selectedRuleSetId, out var selectedId))
        {
            ruleSetId = selectedId;
        }
        else
        {
            var matches = AvailableRuleSetOptions.ToList();
            if (matches.Count != 1)
            {
                message = matches.Count == 0
                    ? "Enter a Rule Set name or choose one from the dropdown."
                    : "More than one Rule Set matches. Choose the Rule Set from the dropdown.";
                return;
            }

            ruleSetId = matches[0].Id;
        }

        await RuleSetAssignments.AssignRuleSetToClientAsync(ClientId, ruleSetId);
        var setName = ruleSets.First(x => x.Id == ruleSetId).Name;
        message = $"Rule Set '{setName}' assigned.";
        ruleSetSearchText = string.Empty;
        selectedRuleSetId = string.Empty;
        await LoadAsync();
    }

    private async Task RemoveRuleSetAsync(Guid ruleSetId)
    {
        var setName = ruleSets.First(x => x.Id == ruleSetId).Name;
        await RuleSetAssignments.RemoveRuleSetFromClientAsync(ClientId, ruleSetId);
        message = $"Rule Set '{setName}' removed.";
        await LoadAsync();
    }

    private void OpenDirectRulePicker()
    {
        showDirectRulePicker = true;
        directRuleSearchText = string.Empty;
        selectedDirectRuleId = string.Empty;
    }

    private void CloseDirectRulePicker()
    {
        showDirectRulePicker = false;
        directRuleSearchText = string.Empty;
        selectedDirectRuleId = string.Empty;
    }

    private async Task AddDirectRuleAsync()
    {
        Guid ruleId;

        if (Guid.TryParse(selectedDirectRuleId, out var selectedId))
        {
            ruleId = selectedId;
        }
        else
        {
            var matches = DirectRuleOptions.ToList();
            if (matches.Count != 1)
            {
                message = matches.Count == 0
                    ? "Enter a rule name or choose one from the dropdown."
                    : "More than one rule matches. Choose the rule from the dropdown.";
                return;
            }

            ruleId = matches[0].Id;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var assignment = await db.ClientRuleAssignments
            .SingleOrDefaultAsync(x => x.ClientId == ClientId && x.MasterRuleId == ruleId);

        if (assignment is null)
        {
            var assignmentMax = await db.ClientRuleAssignments
                .Where(x => x.ClientId == ClientId)
                .Select(x => (int?)x.ExportPriority)
                .MaxAsync() ?? 0;

            var clientRuleMax = await db.ClientRules
                .Where(x => x.ClientId == ClientId)
                .Select(x => (int?)x.ExportPriority)
                .MaxAsync() ?? 0;

            db.ClientRuleAssignments.Add(new ClientRuleAssignment
            {
                ClientId = ClientId,
                MasterRuleId = ruleId,
                Status = RuleAssignmentStatus.Inherited,
                IsExplicit = true,
                ExportPriority = Math.Max(assignmentMax, clientRuleMax) + 1
            });
        }
        else
        {
            assignment.IsExplicit = true;
            assignment.ModifiedUtc = DateTime.UtcNow;
        }

        await db.SaveChangesAsync();
        var ruleName = masterRules.First(x => x.Id == ruleId).Name;
        message = $"Rule '{ruleName}' assigned directly.";
        showDirectRulePicker = false;
        directRuleSearchText = string.Empty;
        selectedDirectRuleId = string.Empty;
        await LoadAsync();
    }

    private async Task RemoveDirectAssignmentAsync(Guid assignmentId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var assignment = await db.ClientRuleAssignments.SingleAsync(x => x.Id == assignmentId);

        if (expectedFromRuleSets.Contains(assignment.MasterRuleId))
        {
            assignment.IsExplicit = false;
            assignment.ModifiedUtc = DateTime.UtcNow;
            message = "Direct assignment removed. The rule remains because it is included in an assigned Rule Set.";
        }
        else
        {
            db.ClientRuleAssignments.Remove(assignment);
            message = "Direct rule removed.";
        }

        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task SetExportPriorityAsync(ExportOrderRow row, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var requestedPriority))
            return;

        var ordered = ExportOrderRows.ToList();
        var currentIndex = ordered.FindIndex(x =>
            x.EntityId == row.EntityId && x.IsClientSpecific == row.IsClientSpecific);

        if (currentIndex < 0)
            return;

        requestedPriority = Math.Clamp(requestedPriority, 1, ordered.Count);
        var selected = ordered[currentIndex];
        ordered.RemoveAt(currentIndex);
        ordered.Insert(requestedPriority - 1, selected);

        await PersistExportOrderAsync(ordered);
    }

    private async Task MoveExportRuleAsync(ExportOrderRow row, int direction)
    {
        var ordered = ExportOrderRows.ToList();
        var currentIndex = ordered.FindIndex(x =>
            x.EntityId == row.EntityId && x.IsClientSpecific == row.IsClientSpecific);
        var targetIndex = currentIndex + direction;

        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= ordered.Count)
            return;

        (ordered[currentIndex], ordered[targetIndex]) = (ordered[targetIndex], ordered[currentIndex]);
        await PersistExportOrderAsync(ordered);
    }

    private async Task PersistExportOrderAsync(IReadOnlyList<ExportOrderRow> ordered)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var assignmentIds = ordered
            .Where(x => !x.IsClientSpecific)
            .Select(x => x.EntityId)
            .ToArray();

        var clientRuleIds = ordered
            .Where(x => x.IsClientSpecific)
            .Select(x => x.EntityId)
            .ToArray();

        var assignmentEntities = await db.ClientRuleAssignments
            .Where(x => assignmentIds.Contains(x.Id))
            .ToDictionaryAsync(x => x.Id);

        var clientRuleEntities = await db.ClientRules
            .Where(x => clientRuleIds.Contains(x.Id))
            .ToDictionaryAsync(x => x.Id);

        for (var i = 0; i < ordered.Count; i++)
        {
            var priority = i + 1;
            var row = ordered[i];

            if (row.IsClientSpecific)
            {
                if (clientRuleEntities.TryGetValue(row.EntityId, out var clientRule))
                {
                    clientRule.ExportPriority = priority;
                    clientRule.ModifiedUtc = DateTime.UtcNow;
                }
            }
            else if (assignmentEntities.TryGetValue(row.EntityId, out var assignment))
            {
                assignment.ExportPriority = priority;
                assignment.ModifiedUtc = DateTime.UtcNow;
            }
        }

        await db.SaveChangesAsync();
        message = "QuickBooks export priority updated.";
        await LoadAsync();
    }

    private bool MatchesRuleSearch(MasterRule rule)
    {
        if (string.IsNullOrWhiteSpace(ruleSearchText))
            return true;

        var term = ruleSearchText.Trim();
        return rule.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (rule.CategoryName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (rule.Payee?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || rule.Conditions.Any(x => x.Value.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private bool MatchesSource(MasterRule rule)
    {
        var fromSet = expectedFromRuleSets.Contains(rule.Id);
        var direct = AssignmentFor(rule.Id)?.IsExplicit == true;

        return sourceFilter switch
        {
            "set" => fromSet && !direct,
            "direct" => direct && !fromSet,
            "both" => fromSet && direct,
            _ => true
        };
    }

    private bool MatchesDirection(MasterRule rule) => directionFilter switch
    {
        "out" => rule.Direction == RuleDirection.MoneyOut,
        "in" => rule.Direction == RuleDirection.MoneyIn,
        _ => true
    };

    private bool MatchesCategory(MasterRule rule) => categoryFilter switch
    {
        "all" => true,
        "none" => string.IsNullOrWhiteSpace(rule.CategoryName),
        _ => string.Equals(rule.CategoryName, categoryFilter, StringComparison.OrdinalIgnoreCase)
    };

    private void ClearRuleFilters()
    {
        ruleSearchText = string.Empty;
        sourceFilter = "all";
        directionFilter = "all";
        categoryFilter = "all";
    }

    private string RuleSetSourceText(Guid masterRuleId)
    {
        var names = ruleSetRules
            .Where(x => x.MasterRuleId == masterRuleId)
            .Join(ruleSets, x => x.RuleSetId, x => x.Id, (_, set) => set.Name)
            .Distinct()
            .OrderBy(x => x)
            .ToArray();

        return names.Length == 0 ? "Rule Set" : string.Join(", ", names);
    }

    private sealed record ExportOrderRow(
        Guid EntityId,
        bool IsClientSpecific,
        int Priority,
        string Name,
        string Source);

    private static string FormatTransactionType(RuleTransactionType type) => type switch
    {
        RuleTransactionType.CreditCardPayment => "Credit card payment",
        _ => string.Concat(type.ToString().Select((c, i) => i > 0 && char.IsUpper(c) ? " " + c : c.ToString()))
    };
}
