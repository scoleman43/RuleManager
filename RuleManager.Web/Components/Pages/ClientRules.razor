@page "/clients/{ClientId:guid}/rules"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using RuleManager.Core.Domain
@using RuleManager.Data
@using RuleManager.Data.Services
@inject IDbContextFactory<RuleManagerDbContext> DbFactory
@inject RuleSetAssignmentService RuleSetAssignments
@inject QuickBooksChartOfAccountsImportService ChartOfAccountsImport
@inject NavigationManager Navigation

<PageTitle>Client Rules</PageTitle>

@if (client is null)
{
    <p>Loading client...</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <button class="btn btn-link p-0 mb-2" @onclick="BackToClients">← Back to Clients</button>
            <h1>@client.Name</h1>
            <p class="text-muted mb-0">Manage the Rule Sets and individual rules assigned to this client.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success">@message</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted">Rule Sets</div>
                <div class="display-6">@assignedRuleSetIds.Count</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted">Total Rules</div>
                <div class="display-6">@ExportOrderRows.Count</div>
                @if (clientSpecificRules.Count > 0)
                {
                    <div class="small text-muted">@AssignedRules.Count() reusable + @clientSpecificRules.Count client-specific</div>
                }
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted">From Rule Sets</div>
                <div class="display-6">@SetRuleCount</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted">Direct Rules</div>
                <div class="display-6">@DirectRuleCount</div>
            </div></div>
        </div>
    </div>

    <div class="card mb-4">
        <button type="button"
                class="btn text-start w-100 p-0 border-0"
                @onclick="ToggleQuickBooksReferencesSection">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-1">Known QuickBooks References (@clientReferences.Count)</h5>
                    <div class="text-muted small">
                        Learned from QuickBooks rule imports and this client's Chart of Accounts export.
                    </div>
                </div>
                <span class="fs-4" aria-hidden="true">@(showQuickBooksReferencesSection ? "▲" : "▼")</span>
            </div>
        </button>

        @if (showQuickBooksReferencesSection)
        {
            <div class="card-body border-top">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3 flex-wrap">
                    <div class="text-muted small">
                        Source bank-account scope is not included in the QBO rule XLS format.
                    </div>
                    <div style="min-width: 320px;">
                        <label class="form-label small mb-1">Import QBO Chart of Accounts</label>
                        <InputFile class="form-control form-control-sm"
                                   OnChange="HandleChartOfAccountsFileAsync"
                                   accept=".csv"
                                   disabled="@isChartOfAccountsImportBusy" />
                        <div class="form-text">Use the CSV exported from QuickBooks Online → Chart of accounts.</div>
                    </div>
                </div>

            @if (!string.IsNullOrWhiteSpace(referenceMessage))
            {
                <div class="alert @(referenceMessageIsError ? "alert-danger" : "alert-success") py-2">
                    @referenceMessage
                </div>
            }

            @if (clientReferences.Count == 0)
            {
                <div class="text-muted">No QuickBooks references have been discovered for this client yet.</div>
            }
            else
            {
                <div class="row g-2 mb-3">
                    <div class="col-auto"><span class="badge text-bg-light">@clientReferences.Count total</span></div>
                    <div class="col-auto"><span class="badge text-bg-light">@BankReferenceCount bank</span></div>
                    <div class="col-auto"><span class="badge text-bg-light">@CreditCardReferenceCount credit card</span></div>
                    <div class="col-auto"><span class="badge text-bg-light">@clientReferences.Count(x => x.Type == ClientReferenceType.Payee) payee</span></div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>QBO Account Type</th>
                                <th>Detail Type</th>
                                <th>Source</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reference in clientReferences
                                .OrderBy(x => x.Type)
                                .ThenBy(x => x.Name))
                            {
                                <tr>
                                    <td>
                                        <strong>@reference.Name</strong>
                                        <div class="small text-muted">@FormatReferenceType(reference.Type)</div>
                                    </td>
                                    <td>@(reference.QuickBooksAccountType ?? "—")</td>
                                    <td>@(reference.QuickBooksDetailType ?? "—")</td>
                                    <td>@FormatReferenceSource(reference.Source)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            </div>
        }
    </div>

    <div class="card mb-4">
        <button type="button"
                class="btn text-start w-100 p-0 border-0"
                @onclick="ToggleRuleSetsSection">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-1">Assigned Rule Sets (@assignedRuleSetIds.Count)</h5>
                    <div class="text-muted small">Rule Sets automatically keep this client up to date when rules are added to the set.</div>
                </div>
                <span class="fs-4" aria-hidden="true">@(showRuleSetsSection ? "▲" : "▼")</span>
            </div>
        </button>

        @if (showRuleSetsSection)
        {
            <div class="card-body border-top">
                @if (AssignedRuleSets.Any())
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Rule Set</th>
                                    <th>Description</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var set in AssignedRuleSets)
                                {
                                    <tr>
                                        <td><strong>@set.Name</strong></td>
                                        <td>@(set.Description ?? "—")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveRuleSetAsync(set.Id)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted mb-3">No Rule Sets are assigned to this client.</div>
                }

                <div class="row g-3 align-items-end">
                    <div class="col-lg-10">
                        <label class="form-label">Rule Set</label>
                        <select class="form-select" @bind="selectedRuleSetId">
                            <option value="">-- Select Rule Set --</option>
                            @foreach (var set in AvailableRuleSetOptions)
                            {
                                <option value="@set.Id">@set.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-lg-2">
                        <button class="btn btn-primary w-100" @onclick="AddRuleSetAsync">Add Rule Set</button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (showDirectRulePicker)
    {
        <div class="rule-modal-backdrop" @onclick="CloseDirectRulePicker">
            <div class="rule-modal-dialog" @onclick:stopPropagation="true">
                <div class="rule-modal-header">
                    <div>
                        <div class="rule-modal-eyebrow">Direct assignment</div>
                        <h5 class="mb-1">Add Direct Rule</h5>
                        <div class="text-muted small">Use this for a one-off rule that should apply to this client outside of its Rule Sets.</div>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CloseDirectRulePicker">Close</button>
                </div>

                <div class="rule-modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Filter Rule</label>
                            <input class="form-control"
                                   @bind="directRuleSearchText"
                                   @bind:event="oninput"
                                   placeholder="Start typing a rule name..." />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Rule</label>
                            <select class="form-select" @bind="selectedDirectRuleId">
                                <option value="">-- Select Rule --</option>
                                @foreach (var rule in DirectRuleOptions)
                                {
                                    <option value="@rule.Id">@rule.Name — @(rule.CategoryName ?? "No category")</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="rule-modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CloseDirectRulePicker">Cancel</button>
                    <button class="btn btn-primary" @onclick="AddDirectRuleAsync">Add Rule</button>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <button type="button"
                class="btn text-start w-100 p-0 border-0"
                @onclick="ToggleAssignedRulesSection">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-1">Reusable Assigned Rules (@AssignedRules.Count())</h5>
                    <div class="text-muted small">
                        Reusable rules are shown here in QuickBooks export priority order.
                        @if (clientSpecificRules.Count > 0)
                        {
                            <span> Client-specific rules are shown separately below but share the same priority sequence, so a priority number may appear to be skipped in this table.</span>
                        }
                    </div>
                </div>
                <span class="fs-4" aria-hidden="true">@(showAssignedRulesSection ? "▲" : "▼")</span>
            </div>
        </button>

        @if (showAssignedRulesSection)
        {
            <div class="card-body border-top">
                <div class="d-flex justify-content-end mb-3">
                    <button class="btn btn-outline-primary" @onclick="OpenDirectRulePicker">Add Direct Rule</button>
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-lg-3">
                                <label class="form-label">Search</label>
                                <input class="form-control"
                                       @bind="ruleSearchText"
                                       @bind:event="oninput"
                                       placeholder="Rule name, category, payee, or condition..." />
                            </div>
                            <div class="col-md-4 col-lg-2">
                                <label class="form-label">Source</label>
                                <select class="form-select" @bind="sourceFilter">
                                    <option value="all">All Assigned Rules</option>
                                    <option value="set">Rule Set</option>
                                    <option value="direct">Direct</option>
                                    <option value="both">Rule Set + Direct</option>
                                </select>
                            </div>
                            <div class="col-md-4 col-lg-2">
                                <label class="form-label">Direction</label>
                                <select class="form-select" @bind="directionFilter">
                                    <option value="all">All</option>
                                    <option value="out">Money out</option>
                                    <option value="in">Money in</option>
                                </select>
                            </div>
                            <div class="col-md-4 col-lg-2">
                                <label class="form-label">Auto Add</label>
                                <select class="form-select" @bind="autoAddFilter">
                                    <option value="all">All</option>
                                    <option value="yes">Yes</option>
                                    <option value="no">No</option>
                                </select>
                            </div>
                            <div class="col-md-4 col-lg-3">
                                <label class="form-label">Category</label>
                                <select class="form-select" @bind="categoryFilter">
                                    <option value="all">All</option>
                                    <option value="none">No category</option>
                                    @foreach (var category in categoryNames)
                                    {
                                        <option value="@category">@category</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div class="text-muted small">Showing @FilteredAssignedRules.Count() of @AssignedRules.Count() reusable assigned rule(s)</div>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearRuleFilters">Clear Filters</button>
                        </div>
                    </div>
                </div>

                @if (!FilteredAssignedRules.Any())
                {
                    <div class="text-muted">
                        @(AssignedRules.Any() ? "No assigned rules match the current search and filters." : "This client does not have any rules assigned yet.")
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th style="width: 100px;">Priority</th>
                                    <th>Rule</th>
                                    <th>Source</th>
                                    <th>Direction</th>
                                    <th>Transaction</th>
                                    <th>Category</th>
                                    <th>Auto Add</th>
                                    <th class="text-end" style="width: 120px;">Move</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rule in FilteredAssignedRules)
                                {
                                    var assignment = AssignmentFor(rule.Id);
                                    var fromSet = expectedFromRuleSets.Contains(rule.Id);
                                    var direct = assignment?.IsExplicit == true;
                                    var exportRow = ExportRowForMasterRule(rule.Id);

                                    <tr @key="rule.Id">
                                        <td>
                                            @if (exportRow is not null)
                                            {
                                                <input @key="@($"{exportRow.EntityId}:{exportRow.Priority}")"
                                                       class="form-control form-control-sm export-priority-input"
                                                       type="number"
                                                       min="1"
                                                       max="@ExportOrderRows.Count"
                                                       value="@exportRow.Priority"
                                                       @onchange="e => SetExportPriorityAsync(exportRow, e)" />
                                            }
                                        </td>
                                        <td>
                                            <strong>@rule.Name</strong>
                                            @if (!string.IsNullOrWhiteSpace(rule.Payee))
                                            {
                                                <div class="small text-muted">Payee: @rule.Payee</div>
                                            }
                                        </td>
                                        <td>
                                            @if (fromSet)
                                            {
                                                <span class="badge rule-source-set me-1">@RuleSetSourceText(rule.Id)</span>
                                            }
                                            @if (direct)
                                            {
                                                <span class="badge rule-source-direct">Direct</span>
                                            }
                                        </td>
                                        <td>@(rule.Direction == RuleDirection.MoneyOut ? "Money out" : "Money in")</td>
                                        <td>@FormatTransactionType(rule.TransactionType)</td>
                                        <td>@(rule.CategoryName ?? "—")</td>
                                        <td>
                                            <span class="badge @(rule.AutoAdd ? "status-badge-active" : "status-badge-inactive")">
                                                @(rule.AutoAdd ? "Yes" : "No")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            @if (exportRow is not null)
                                            {
                                                <div class="btn-group btn-group-sm" role="group" aria-label="Change export priority">
                                                    <button class="btn btn-outline-secondary"
                                                            title="Move up"
                                                            disabled="@(exportRow.Priority <= 1)"
                                                            @onclick="() => MoveExportRuleAsync(exportRow, -1)">↑</button>
                                                    <button class="btn btn-outline-secondary"
                                                            title="Move down"
                                                            disabled="@(exportRow.Priority >= ExportOrderRows.Count)"
                                                            @onclick="() => MoveExportRuleAsync(exportRow, 1)">↓</button>
                                                </div>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-2 flex-wrap">
                                                @if (!rule.IsReadOnlyImport || QuickBooksSplitRuleCodec.IsSplitRule(rule.OriginalOutputsJson))
                                                {
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => CloneForClient(rule.Id)">
                                                        Clone
                                                    </button>
                                                }
                                                @if (direct)
                                                {
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveDirectAssignmentAsync(assignment!.Id)">
                                                        Remove Direct
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="small text-muted align-self-center">Managed by Rule Set</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>

    @if (clientSpecificRules.Count > 0)
    {
        <div class="card mt-4">
            <div class="card-body">
                <h5 class="card-title mb-1">Client-Specific Imported Rules (@clientSpecificRules.Count)</h5>
                <div class="text-muted small mb-3">
                    These rules contain QuickBooks account-specific data that cannot be safely shared with other clients.
                    They still participate in the same QuickBooks export priority sequence shown above.
                </div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th style="width: 100px;">Priority</th>
                                <th>Rule</th>
                                <th>Direction</th>
                                <th>Transaction</th>
                                <th>Account / Category</th>
                                <th>Auto Add</th>
                                <th>Status</th>
                                <th class="text-end" style="width: 120px;">Move</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in clientSpecificRules)
                            {
                                var exportRow = ExportRowForClientSpecificRule(rule.Id);

                                <tr @key="rule.Id">
                                    <td>
                                        @if (exportRow is not null)
                                        {
                                            <input @key="@($"{exportRow.EntityId}:{exportRow.Priority}")"
                                                   class="form-control form-control-sm export-priority-input"
                                                   type="number"
                                                   min="1"
                                                   max="@ExportOrderRows.Count"
                                                   value="@exportRow.Priority"
                                                   @onchange="e => SetExportPriorityAsync(exportRow, e)" />
                                        }
                                    </td>
                                    <td><strong>@rule.Name</strong></td>
                                    <td>@(rule.Direction == RuleDirection.MoneyOut ? "Money out" : "Money in")</td>
                                    <td>@FormatTransactionType(rule.TransactionType)</td>
                                    <td>@(rule.CategoryName ?? "—")</td>
                                    <td>
                                        <span class="badge @(rule.AutoAdd ? "status-badge-active" : "status-badge-inactive")">
                                            @(rule.AutoAdd ? "Yes" : "No")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge status-badge-client-specific">Client-specific</span>
                                    </td>
                                    <td class="text-end">
                                        @if (exportRow is not null)
                                        {
                                            <div class="btn-group btn-group-sm" role="group" aria-label="Change export priority">
                                                <button class="btn btn-outline-secondary"
                                                        title="Move up"
                                                        disabled="@(exportRow.Priority <= 1)"
                                                        @onclick="() => MoveExportRuleAsync(exportRow, -1)">↑</button>
                                                <button class="btn btn-outline-secondary"
                                                        title="Move down"
                                                        disabled="@(exportRow.Priority >= ExportOrderRows.Count)"
                                                        @onclick="() => MoveExportRuleAsync(exportRow, 1)">↓</button>
                                            </div>
                                        }
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid ClientId { get; set; }

    private Client? client;
    private readonly List<MasterRule> masterRules = new();
    private readonly List<RuleSet> ruleSets = new();
    private readonly List<RuleSetRule> ruleSetRules = new();
    private readonly List<ClientRuleAssignment> assignments = new();
    private readonly List<ClientRule> clientSpecificRules = new();
    private readonly List<ClientReference> clientReferences = new();
    private readonly HashSet<Guid> assignedRuleSetIds = new();
    private readonly HashSet<Guid> expectedFromRuleSets = new();
    private readonly List<string> categoryNames = new();

    private string? message;
    private string? referenceMessage;
    private bool referenceMessageIsError;
    private bool isChartOfAccountsImportBusy;
    private bool showQuickBooksReferencesSection;
    private bool showRuleSetsSection;
    private bool showAssignedRulesSection = true;

    private string selectedRuleSetId = string.Empty;

    private bool showDirectRulePicker;
    private string directRuleSearchText = string.Empty;
    private string selectedDirectRuleId = string.Empty;

    private string ruleSearchText = string.Empty;
    private string sourceFilter = "all";
    private string directionFilter = "all";
    private string autoAddFilter = "all";
    private string categoryFilter = "all";

    private IEnumerable<RuleSet> AssignedRuleSets =>
        ruleSets.Where(x => assignedRuleSetIds.Contains(x.Id));

    private IEnumerable<RuleSet> AvailableRuleSetOptions =>
        ruleSets.Where(set => !assignedRuleSetIds.Contains(set.Id));

    private IEnumerable<MasterRule> AssignedRules =>
        masterRules.Where(rule =>
            expectedFromRuleSets.Contains(rule.Id)
            || AssignmentFor(rule.Id)?.IsExplicit == true);

    private IEnumerable<MasterRule> FilteredAssignedRules =>
        AssignedRules.Where(rule =>
            MatchesRuleSearch(rule)
            && MatchesSource(rule)
            && MatchesDirection(rule)
            && MatchesAutoAdd(rule)
            && MatchesCategory(rule))
        .OrderBy(rule => AssignmentFor(rule.Id)?.ExportPriority ?? int.MaxValue)
        .ThenBy(rule => rule.Name);

    private IEnumerable<MasterRule> DirectRuleOptions =>
        masterRules.Where(rule =>
            AssignmentFor(rule.Id)?.IsExplicit != true
            && (string.IsNullOrWhiteSpace(directRuleSearchText)
                || rule.Name.Contains(directRuleSearchText.Trim(), StringComparison.OrdinalIgnoreCase)
                || (rule.CategoryName?.Contains(directRuleSearchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                || (rule.Payee?.Contains(directRuleSearchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)));

    private IReadOnlyList<ExportOrderRow> ExportOrderRows
    {
        get
        {
            var clientSpecificNames = clientSpecificRules
                .Select(x => x.Name)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var reusableRows = assignments
                .Join(masterRules,
                    assignment => assignment.MasterRuleId,
                    rule => rule.Id,
                    (assignment, rule) => new { assignment, rule })
                .Where(x => !clientSpecificNames.Contains(x.rule.Name))
                .Select(x =>
                {
                    var fromSet = expectedFromRuleSets.Contains(x.rule.Id);
                    var direct = x.assignment.IsExplicit;
                    var source = fromSet && direct
                        ? "Rule Set + Direct"
                        : fromSet
                            ? "Rule Set"
                            : "Direct";

                    return new ExportOrderRow(
                        x.assignment.Id,
                        false,
                        x.assignment.ExportPriority,
                        x.rule.Name,
                        source);
                });

            var clientRows = clientSpecificRules.Select(rule =>
                new ExportOrderRow(
                    rule.Id,
                    true,
                    rule.ExportPriority,
                    rule.Name,
                    "Client-specific"));

            return reusableRows
                .Concat(clientRows)
                .OrderBy(x => x.Priority)
                .ThenBy(x => x.Name)
                .ToList();
        }
    }

    private int SetRuleCount => AssignedRules.Count(x => expectedFromRuleSets.Contains(x.Id));
    private int DirectRuleCount => AssignedRules.Count(x => AssignmentFor(x.Id)?.IsExplicit == true);
    private int BankReferenceCount => clientReferences.Count(x =>
        string.Equals(x.QuickBooksAccountType, "Bank", StringComparison.OrdinalIgnoreCase));
    private int CreditCardReferenceCount => clientReferences.Count(x =>
        string.Equals(x.QuickBooksAccountType, "Credit Card", StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        client = await db.Clients.AsNoTracking().SingleOrDefaultAsync(x => x.Id == ClientId);
        if (client is null)
        {
            Navigation.NavigateTo("/clients");
            return;
        }

        masterRules.Clear();
        masterRules.AddRange(await db.MasterRules
            .Where(x => x.OrganizationId == client.OrganizationId && x.IsActive)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());

        ruleSets.Clear();
        ruleSets.AddRange(await db.RuleSets
            .Where(x => x.OrganizationId == client.OrganizationId && x.IsActive)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());

        assignedRuleSetIds.Clear();
        foreach (var id in await db.ClientRuleSetAssignments
            .Where(x => x.ClientId == ClientId)
            .Select(x => x.RuleSetId)
            .ToListAsync())
        {
            assignedRuleSetIds.Add(id);
        }

        ruleSetRules.Clear();
        var assignedSetIds = assignedRuleSetIds.ToArray();
        if (assignedSetIds.Length > 0)
        {
            ruleSetRules.AddRange(await db.RuleSetRules
                .Where(x => assignedSetIds.Contains(x.RuleSetId))
                .AsNoTracking()
                .ToListAsync());
        }

        expectedFromRuleSets.Clear();
        foreach (var id in ruleSetRules.Select(x => x.MasterRuleId).Distinct())
            expectedFromRuleSets.Add(id);

        assignments.Clear();
        assignments.AddRange(await db.ClientRuleAssignments
            .Where(x => x.ClientId == ClientId)
            .AsNoTracking()
            .ToListAsync());

        clientSpecificRules.Clear();
        clientSpecificRules.AddRange(await db.ClientRules
            .Where(x => x.ClientId == ClientId && x.IsAccountSpecific)
            .OrderBy(x => x.ExportPriority)
            .ThenBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());

        clientReferences.Clear();
        clientReferences.AddRange(await db.ClientReferences
            .Where(x => x.ClientId == ClientId && x.IsActive)
            .OrderBy(x => x.Type)
            .ThenBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());

        await NormalizeExportPrioritiesAsync(db);

        categoryNames.Clear();
        categoryNames.AddRange(AssignedRules
            .Select(x => x.CategoryName)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x));
    }

    private async Task NormalizeExportPrioritiesAsync(RuleManagerDbContext db)
    {
        var clientSpecificNames = clientSpecificRules
            .Select(x => x.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var visibleAssignmentRows = assignments
            .Join(masterRules,
                assignment => assignment.MasterRuleId,
                rule => rule.Id,
                (assignment, rule) => new
                {
                    Assignment = assignment,
                    Rule = rule
                })
            .Where(x => !clientSpecificNames.Contains(x.Rule.Name))
            .Select(x => new
            {
                EntityId = x.Assignment.Id,
                IsClientSpecific = false,
                StoredPriority = x.Assignment.ExportPriority,
                CreatedUtc = x.Assignment.CreatedUtc,
                Name = x.Rule.Name
            });

        var clientRows = clientSpecificRules.Select(rule => new
        {
            EntityId = rule.Id,
            IsClientSpecific = true,
            StoredPriority = rule.ExportPriority,
            CreatedUtc = rule.CreatedUtc,
            Name = rule.Name
        });

        var ordered = visibleAssignmentRows
            .Concat(clientRows)
            .OrderBy(x => x.StoredPriority <= 0 ? int.MaxValue : x.StoredPriority)
            .ThenBy(x => x.CreatedUtc)
            .ThenBy(x => x.Name)
            .ToList();

        var needsNormalization = ordered
            .Select((row, index) => row.StoredPriority != index + 1)
            .Any(x => x);

        if (!needsNormalization)
            return;

        var assignmentIds = ordered
            .Where(x => !x.IsClientSpecific)
            .Select(x => x.EntityId)
            .ToArray();

        var clientRuleIds = ordered
            .Where(x => x.IsClientSpecific)
            .Select(x => x.EntityId)
            .ToArray();

        var assignmentEntities = await db.ClientRuleAssignments
            .Where(x => assignmentIds.Contains(x.Id))
            .ToDictionaryAsync(x => x.Id);

        var clientRuleEntities = await db.ClientRules
            .Where(x => clientRuleIds.Contains(x.Id))
            .ToDictionaryAsync(x => x.Id);

        for (var i = 0; i < ordered.Count; i++)
        {
            var priority = i + 1;
            var row = ordered[i];

            if (row.IsClientSpecific)
            {
                if (clientRuleEntities.TryGetValue(row.EntityId, out var entity))
                {
                    entity.ExportPriority = priority;
                    entity.ModifiedUtc = DateTime.UtcNow;
                }

                var loaded = clientSpecificRules.FirstOrDefault(x => x.Id == row.EntityId);
                if (loaded is not null)
                    loaded.ExportPriority = priority;
            }
            else
            {
                if (assignmentEntities.TryGetValue(row.EntityId, out var entity))
                {
                    entity.ExportPriority = priority;
                    entity.ModifiedUtc = DateTime.UtcNow;
                }

                var loaded = assignments.FirstOrDefault(x => x.Id == row.EntityId);
                if (loaded is not null)
                    loaded.ExportPriority = priority;
            }
        }

        await db.SaveChangesAsync();
    }

    private async Task HandleChartOfAccountsFileAsync(InputFileChangeEventArgs e)
    {
        referenceMessage = null;
        referenceMessageIsError = false;

        var file = e.File;
        if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
        {
            referenceMessage = "Select the .csv file exported from QuickBooks Online Chart of accounts.";
            referenceMessageIsError = true;
            return;
        }

        isChartOfAccountsImportBusy = true;

        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var result = await ChartOfAccountsImport.ImportAsync(ClientId, stream);

            referenceMessage =
                $"Chart of Accounts imported: {result.TotalRows} row(s), {result.Added} added, {result.Updated} updated.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            referenceMessage = $"Chart of Accounts import failed: {ex.Message}";
            referenceMessageIsError = true;
        }
        finally
        {
            isChartOfAccountsImportBusy = false;
        }
    }

