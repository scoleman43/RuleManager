@page "/rule-sets"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using RuleManager.Core.Domain
@using RuleManager.Data
@using RuleManager.Data.Services
@inject IDbContextFactory<RuleManagerDbContext> DbFactory
@inject WorkspaceService Workspace
@inject NavigationManager Navigation

<PageTitle>Rule Sets</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Rule Sets</h1>
        <p class="text-muted mb-0">Create and manage reusable groups of rules.</p>
    </div>
    <button class="btn btn-primary" @onclick="CreateRuleSet">New Rule Set</button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-success">@message</div>
}

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-8 col-lg-6">
                <label class="form-label">Search</label>
                <input class="form-control"
                       @bind="searchText"
                       @bind:event="oninput"
                       placeholder="Rule Set name or description..." />
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-secondary" @onclick="ClearSearch">Clear</button>
            </div>
        </div>

        <div class="text-muted small mt-3">
            Showing @FilteredRuleSets.Count() of @ruleSets.Count Rule Set(s)
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!FilteredRuleSets.Any())
        {
            <div class="p-4 text-muted">
                @(ruleSets.Count == 0 ? "No Rule Sets have been created yet." : "No Rule Sets match your search.")
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Rule Set</th>
                            <th>Description</th>
                            <th>Rules</th>
                            <th>Clients</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var set in FilteredRuleSets)
                        {
                            <tr>
                                <td><strong>@set.Name</strong></td>
                                <td>@(set.Description ?? "—")</td>
                                <td>@RuleCount(set.Id)</td>
                                <td>@ClientCount(set.Id)</td>
                                <td>
                                    <span class="badge @(set.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                        @(set.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => EditRuleSet(set.Id)">Edit</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleSetActiveAsync(set)">
                                        @(set.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private Guid organizationId;
    private readonly List<RuleSet> ruleSets = new();
    private readonly Dictionary<Guid, int> ruleCounts = new();
    private readonly Dictionary<Guid, int> clientCounts = new();
    private string searchText = string.Empty;
    private string? message;

    private IEnumerable<RuleSet> FilteredRuleSets =>
        ruleSets.Where(set =>
            string.IsNullOrWhiteSpace(searchText)
            || set.Name.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase)
            || (set.Description?.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        organizationId = await Workspace.GetOrCreateDefaultOrganizationIdAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        ruleSets.Clear();
        ruleSets.AddRange(await db.RuleSets
            .Where(x => x.OrganizationId == organizationId)
            .OrderByDescending(x => x.IsActive)
            .ThenBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());

        var ids = ruleSets.Select(x => x.Id).ToArray();

        ruleCounts.Clear();
        foreach (var item in await db.RuleSetRules
            .Where(x => ids.Contains(x.RuleSetId))
            .GroupBy(x => x.RuleSetId)
            .Select(g => new { RuleSetId = g.Key, Count = g.Count() })
            .ToListAsync())
        {
            ruleCounts[item.RuleSetId] = item.Count;
        }

        clientCounts.Clear();
        foreach (var item in await db.ClientRuleSetAssignments
            .Where(x => ids.Contains(x.RuleSetId))
            .GroupBy(x => x.RuleSetId)
            .Select(g => new { RuleSetId = g.Key, Count = g.Count() })
            .ToListAsync())
        {
            clientCounts[item.RuleSetId] = item.Count;
        }
    }

    private int RuleCount(Guid ruleSetId) =>
        ruleCounts.TryGetValue(ruleSetId, out var count) ? count : 0;

    private int ClientCount(Guid ruleSetId) =>
        clientCounts.TryGetValue(ruleSetId, out var count) ? count : 0;

    private void ClearSearch() => searchText = string.Empty;

    private void CreateRuleSet() => Navigation.NavigateTo("/rule-sets/new");

    private void EditRuleSet(Guid id) => Navigation.NavigateTo($"/rule-sets/{id}/edit");

    private async Task ToggleSetActiveAsync(RuleSet set)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.RuleSets.SingleAsync(x => x.Id == set.Id);
        entity.IsActive = !entity.IsActive;
        entity.ModifiedUtc = DateTime.UtcNow;
        await db.SaveChangesAsync();

        message = entity.IsActive ? "Rule Set activated." : "Rule Set deactivated.";
        await LoadAsync();
    }
}
