@page "/imports-exports"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using RuleManager.Core.Domain
@using RuleManager.Data
@using RuleManager.Data.Services
@inject IDbContextFactory<RuleManagerDbContext> DbFactory
@inject WorkspaceService Workspace
@inject QuickBooksRuleImportService ImportService
@inject QuickBooksRuleExportService ExportService
@inject RuleSetAssignmentService RuleSetAssignments
@inject IJSRuntime JS

<PageTitle>Imports / Exports</PageTitle>

<h1>Imports / Exports</h1>
<p class="text-muted">Import QuickBooks rules for a client or add reusable rules to the shared rule library, then generate client-specific exports.</p>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info">@message</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5>Import</h5>
                <p class="text-muted">Apply a QuickBooks rule export to a client, including client-specific account rules, or add reusable rules to the shared library only.</p>
                <button class="btn btn-outline-primary" @onclick="OpenImport">Import Rules</button>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5>Export</h5>
                <p class="text-muted">Generate a QuickBooks-compatible workbook from a client's assigned rules.</p>
                <button class="btn btn-outline-primary" @onclick="OpenExport">Generate Export</button>
            </div>
        </div>
    </div>
</div>

@if (showImport)
{
    <div class="card mb-4 border-primary">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="card-title mb-1">Import Rules</h5>
                    <div class="text-muted">A client import adds or updates reusable rules in the shared library, assigns those rules to the client, and keeps account-specific rules private to that client.</div>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseImport">Close</button>
            </div>

            <div class="row g-3">
                <div class="col-lg-12">
                    <label class="form-label">QuickBooks rule file</label>
                    <InputFile class="form-control" OnChange="HandleImportFileAsync" accept=".xls" />
                    <div class="form-text">Use the .xls file exported from QuickBooks Online.</div>
                </div>
            </div>

            <div class="border rounded p-3 mt-3">
                <label class="form-label d-block">Import destination</label>

                <div class="form-check mb-2">
                    <input class="form-check-input"
                           type="radio"
                           name="importMode"
                           id="importForClient"
                           checked="@(!libraryOnlyImport)"
                           @onchange="() => SetImportMode(false)" />
                    <label class="form-check-label" for="importForClient">
                        <strong>Apply import to a client</strong>
                        <span class="d-block small text-muted">General rules are added or updated in the shared rule library and assigned to this client. Account-specific rules stay tied only to this client.</span>
                    </label>
                </div>

                <div class="form-check">
                    <input class="form-check-input"
                           type="radio"
                           name="importMode"
                           id="importLibraryOnly"
                           checked="@libraryOnlyImport"
                           @onchange="() => SetImportMode(true)" />
                    <label class="form-check-label" for="importLibraryOnly">
                        <strong>Add reusable rules to the rule library only</strong>
                        <span class="d-block small text-muted">Use this only to grow the shared reusable rule pool without assigning rules to a client. Account-specific rules are skipped.</span>
                    </label>
                </div>

                @if (!libraryOnlyImport)
                {
                    <div class="mt-3">
                        <label class="form-label">Client</label>
                        <select class="form-select" @bind="importClientId">
                            <option value="">-- Select client --</option>
                            @foreach (var client in clients)
                            {
                                <option value="@client.Id">@client.Name</option>
                            }
                        </select>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(importFileName))
            {
                <div class="alert alert-secondary mt-3 mb-0">
                    Selected: <strong>@importFileName</strong>
                    @if (importFileSize > 0)
                    {
                        <span class="text-muted">(@FormatFileSize(importFileSize))</span>
                    }
                </div>
            }

            <div class="mt-3">
                <button class="btn btn-primary" @onclick="StartImportAsync" disabled="@isImportBusy">
                    @(isImportBusy ? "Reading File..." : "Continue Import")
                </button>
            </div>
        </div>
    </div>
}

@if (showImportReview)
{
    <div class="card mb-4 border-primary">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="card-title mb-1">Review Import</h5>
                    <div class="text-muted">Review the rules before applying the import. The original file order is preserved as the client's QuickBooks export priority.</div>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelImportReview">Cancel Review</button>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md">
                    <div class="border rounded p-2"><strong>@CountStatus(RuleImportStatus.New)</strong> New</div>
                </div>
                <div class="col-md">
                    <div class="border rounded p-2"><strong>@CountStatus(RuleImportStatus.Changed)</strong> Changed</div>
                </div>
                <div class="col-md">
                    <div class="border rounded p-2"><strong>@CountStatus(RuleImportStatus.Unchanged)</strong> Unchanged</div>
                </div>
                <div class="col-md">
                    <div class="border rounded p-2"><strong>@CountStatus(RuleImportStatus.Duplicate)</strong> Duplicate</div>
                </div>
                <div class="col-md">
                    <div class="border rounded p-2"><strong>@CountStatus(RuleImportStatus.ClientSpecific)</strong> Client-specific</div>
                </div>
                <div class="col-md">
                    <div class="border rounded p-2"><strong>@CountStatus(RuleImportStatus.Unsupported)</strong> Unsupported</div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-lg-6">
                    <label class="form-label">Search</label>
                    <input class="form-control"
                           @bind="previewSearchText"
                           @bind:event="oninput"
                           placeholder="Rule name or category..." />
                </div>
                <div class="col-lg-3">
                    <label class="form-label">Status</label>
                    <select class="form-select" @bind="previewStatusFilter">
                        <option value="all">All</option>
                        <option value="@RuleImportStatus.New">New</option>
                        <option value="@RuleImportStatus.Changed">Changed</option>
                        <option value="@RuleImportStatus.Unchanged">Unchanged</option>
                        <option value="@RuleImportStatus.Duplicate">Duplicate</option>
                        <option value="@RuleImportStatus.ClientSpecific">Client-specific</option>
                        <option value="@RuleImportStatus.Unsupported">Unsupported</option>
                    </select>
                </div>
                <div class="col-lg-3 d-flex align-items-end">
                    <button class="btn btn-outline-secondary w-100" @onclick="ClearPreviewFilters">Clear Filters</button>
                </div>
            </div>

            @if (CountStatus(RuleImportStatus.ClientSpecific) > 0)
            {
                <div class="alert alert-warning">
                    <strong>Client-specific rules detected.</strong>
                    @if (libraryOnlyImport)
                    {
                        <span> These rules contain account-specific QuickBooks data and will not be imported in library-only mode.</span>
                    }
                    else
                    {
                        <span> These account-specific rules will be stored only for the selected client, while general imported rules remain reusable in the shared library.</span>
                    }
                </div>
            }

            @if (CountStatus(RuleImportStatus.New) > 0 || CountStatus(RuleImportStatus.Changed) > 0)
            {
                <div class="alert alert-info">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <strong>
                                @CountStatus(RuleImportStatus.New) new and
                                @CountStatus(RuleImportStatus.Changed) changed reusable rule(s) detected.
                            </strong>
                            <div class="small mt-1">
                                Changed means the rule name already exists in the library, but its conditions or settings differ.
                                Selected New and Changed rules can also be added to an existing Rule Set. Changed rules created as new will use the new name you enter.
                            </div>
                        </div>
                    </div>

                    <div class="form-check mt-3">
                        <input class="form-check-input"
                               type="checkbox"
                               @bind="addImportedRulesToRuleSet"
                               id="addNewRulesToRuleSet" />
                        <label class="form-check-label" for="addNewRulesToRuleSet">
                            Add selected new or changed rules to a Rule Set
                        </label>
                    </div>

                    @if (addImportedRulesToRuleSet)
                    {
                        <div class="row g-3 mt-1">
                            <div class="col-lg-6">
                                <label class="form-label">Find Rule Set</label>
                                <input class="form-control"
                                       @bind="ruleSetSearchText"
                                       @bind:event="oninput"
                                       placeholder="Start typing a Rule Set name..." />
                            </div>

                            <div class="col-lg-6">
                                <label class="form-label">Rule Set</label>
                                <select class="form-select" @bind="importRuleSetId">
                                    <option value="">-- Select Rule Set --</option>
                                    @foreach (var set in ImportRuleSetOptions)
                                    {
                                        <option value="@set.Id">@set.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-text mt-2">
                            Only selected rules marked <strong>New</strong> or <strong>Changed</strong> will be added to this Rule Set.
                        </div>
                    }
                </div>
            }

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width:70px">Import</th>
                            <th>Rule</th>
                            <th>Status</th>
                            <th>Direction</th>
                            <th>Transaction</th>
                            <th>Category</th>
                            <th>Import Action</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredPreviewItems)
                        {
                            var selectable = libraryOnlyImport
                                ? item.Status is RuleImportStatus.New or RuleImportStatus.Changed
                                : item.Status is RuleImportStatus.New or RuleImportStatus.Changed or RuleImportStatus.Unchanged or RuleImportStatus.ClientSpecific;
                            <tr>
                                <td>
                                    <input class="form-check-input"
                                           type="checkbox"
                                           @bind="item.Selected"
                                           disabled="@(!selectable)" />
                                </td>
                                <td>
                                    <strong>@item.Name</strong>
                                    <div class="small text-muted">Row @item.RowNumber</div>
                                </td>
                                <td><span class="@ImportStatusClass(item.Status)">@item.Status</span></td>
                                <td>@(item.Direction == RuleDirection.MoneyOut ? "Money out" : "Money in")</td>
                                <td>@FormatTransactionType(item.TransactionType)</td>
                                <td>@(item.CategoryName ?? "—")</td>
                                <td>
                                    @if (item.Status == RuleImportStatus.Changed)
                                    {
                                        <select class="form-select form-select-sm mb-2"
                                                @bind="item.ChangedAction">
                                            <option value="@ChangedRuleImportAction.UpdateExisting">Update existing</option>
                                            <option value="@ChangedRuleImportAction.CreateNew">Create as new</option>
                                        </select>

                                        @if (item.ChangedAction == ChangedRuleImportAction.CreateNew)
                                        {
                                            <input class="form-control form-control-sm"
                                                   @bind="item.NewRuleName"
                                                   placeholder="New unique rule name" />
                                        }
                                    }
                                    else
                                    {
                                        <span class="small text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.UnsupportedReason))
                                    {
                                        <span class="small">@item.UnsupportedReason</span>
                                    }
                                    else if (item.Status == RuleImportStatus.Changed)
                                    {
                                        <span class="small text-muted">Same rule name exists, but the conditions or settings differ. Choose whether to update the existing reusable rule or create a separate reusable rule.</span>
                                    }
                                    else if (item.Status == RuleImportStatus.Unchanged)
                                    {
                                        <span class="small text-muted">Already matches the rule library.</span>
                                    }
                                    else if (item.Status == RuleImportStatus.Duplicate)
                                    {
                                        <span class="small text-muted">The import file contains this rule name more than once.</span>
                                    }
                                    else if (item.Status == RuleImportStatus.ClientSpecific)
                                    {
                                        <span class="small text-muted">Account-specific rule. It will be stored only for the selected client and exported using its preserved QuickBooks data.</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <div class="text-muted small">
                    @previewItems.Count(x => x.Selected) rule(s) selected.
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" @onclick="CancelImportReview">Back</button>
                    <button class="btn btn-primary" @onclick="CommitImportAsync" disabled="@(isImportBusy || previewItems.Count(x => x.Selected) == 0)">
                        @(isImportBusy ? "Importing..." : "Import Selected Rules")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showExport)
{
    <div class="card mb-4 border-primary">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="card-title mb-1">Generate Export</h5>
                    <div class="text-muted">Choose the client whose effective assigned rules should be exported.</div>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseExport">Close</button>
            </div>

            <div class="row g-3 align-items-end">
                <div class="col-lg-8">
                    <label class="form-label">Client</label>
                    <select class="form-select" @bind="exportClientId">
                        <option value="">-- Select client --</option>
                        @foreach (var client in clients)
                        {
                            <option value="@client.Id">@client.Name</option>
                        }
                    </select>
                </div>

                <div class="col-lg-4">
                    <button class="btn btn-primary w-100" @onclick="StartExportAsync" disabled="@isExportBusy">
                        @(isExportBusy ? "Generating..." : "Generate & Download")
                    </button>
                </div>
            </div>

            @if (exportErrors.Count > 0)
            {
                <div class="alert alert-warning mt-3 mb-0">
                    <strong>The export was not generated because these rules need attention:</strong>
                    <ul class="mb-0 mt-2">
                        @foreach (var error in exportErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
}

@code {
    private const long MaxImportFileSize = 20 * 1024 * 1024;

    private Guid organizationId;
    private readonly List<Client> clients = new();
    private readonly List<RuleSet> ruleSets = new();
    private readonly List<RuleImportPreviewItem> previewItems = new();

    private bool showImport;
    private bool showImportReview;
    private bool showExport;
    private bool isImportBusy;
    private bool isExportBusy;
    private readonly List<string> exportErrors = new();
    private string importClientId = string.Empty;
    private string exportClientId = string.Empty;
    private string? importFileName;
    private long importFileSize;
    private byte[]? importFileBytes;
    private bool libraryOnlyImport;
    private bool addImportedRulesToRuleSet;
    private string ruleSetSearchText = string.Empty;
    private string importRuleSetId = string.Empty;
    private string previewSearchText = string.Empty;
    private string previewStatusFilter = "all";
    private string? message;

    private IEnumerable<RuleSet> ImportRuleSetOptions =>
        ruleSets.Where(set =>
            string.IsNullOrWhiteSpace(ruleSetSearchText)
            || set.Name.Contains(ruleSetSearchText.Trim(), StringComparison.OrdinalIgnoreCase));

    private IEnumerable<RuleImportPreviewItem> FilteredPreviewItems =>
        previewItems.Where(item =>
            (string.IsNullOrWhiteSpace(previewSearchText)
             || item.Name.Contains(previewSearchText.Trim(), StringComparison.OrdinalIgnoreCase)
             || (item.CategoryName?.Contains(previewSearchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))
            && (previewStatusFilter == "all" || item.Status.ToString() == previewStatusFilter));

    protected override async Task OnInitializedAsync()
    {
        organizationId = await Workspace.GetOrCreateDefaultOrganizationIdAsync();

        await using var db = await DbFactory.CreateDbContextAsync();
        clients.AddRange(await db.Clients
            .Where(x => x.OrganizationId == organizationId && x.IsActive)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());

        ruleSets.AddRange(await db.RuleSets
            .Where(x => x.OrganizationId == organizationId && x.IsActive)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());
    }

    private void OpenImport()
    {
        showImport = true;
        showExport = false;
        showImportReview = false;
        message = null;
    }

    private void SetImportMode(bool libraryOnly)
    {
        libraryOnlyImport = libraryOnly;

        if (libraryOnly)
            importClientId = string.Empty;

        previewItems.Clear();
        showImportReview = false;
        message = null;
    }

    private void CloseImport()
    {
        showImport = false;
        showImportReview = false;
        ResetImportState();
    }

    private void OpenExport()
    {
        showExport = true;
        showImport = false;
        showImportReview = false;
        exportErrors.Clear();
        message = null;
    }

    private void CloseExport()
    {
        showExport = false;
        exportClientId = string.Empty;
        exportErrors.Clear();
    }

    private async Task HandleImportFileAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        importFileName = file.Name;
        importFileSize = file.Size;
        importFileBytes = null;
        previewItems.Clear();
        showImportReview = false;

        if (!file.Name.EndsWith(".xls", StringComparison.OrdinalIgnoreCase))
        {
            message = "QuickBooks rule imports must use the .xls export format.";
            return;
        }

        if (file.Size > MaxImportFileSize)
        {
            message = "The selected file is larger than the 20 MB import limit.";
            return;
        }

        try
        {
            await using var source = file.OpenReadStream(MaxImportFileSize);
            using var memory = new MemoryStream();
            await source.CopyToAsync(memory);
            importFileBytes = memory.ToArray();
            message = null;
        }
        catch (Exception ex)
        {
            message = $"The file could not be read: {ex.Message}";
        }
    }

    private async Task StartImportAsync()
    {
        if (!libraryOnlyImport && !Guid.TryParse(importClientId, out _))
        {
            message = "Select the client this QuickBooks rule export belongs to.";
            return;
        }

        if (importFileBytes is null || importFileBytes.Length == 0)
        {
            message = "Choose a QuickBooks .xls rule file.";
            return;
        }

        isImportBusy = true;
        message = null;

        try
        {
            using var stream = new MemoryStream(importFileBytes, writable: false);
            var items = await ImportService.AnalyzeAsync(organizationId, stream);

            previewItems.Clear();
            previewItems.AddRange(items);

            foreach (var item in previewItems)
            {
                item.Selected = libraryOnlyImport
                    ? item.Status is RuleImportStatus.New or RuleImportStatus.Changed
                    : item.Status is RuleImportStatus.New or RuleImportStatus.Changed or RuleImportStatus.Unchanged or RuleImportStatus.ClientSpecific;
            }

            addImportedRulesToRuleSet = false;
            ruleSetSearchText = string.Empty;
            importRuleSetId = string.Empty;

            showImportReview = true;
            showImport = false;

            message = previewItems.Count == 0
                ? "No rule rows were found in the workbook."
                : $"Read {previewItems.Count} rule(s). Review the results below before importing.";
        }
        catch (Exception ex)
        {
            message = $"Import could not be analyzed: {ex.Message}";
        }
        finally
        {
            isImportBusy = false;
        }
    }

    private async Task CommitImportAsync()
    {
        if (previewItems.Count(x => x.Selected) == 0)
        {
            message = "Select at least one rule to import.";
            return;
        }

        var invalidCreateAsNew = previewItems
            .FirstOrDefault(x => x.Selected
                && x.Status == RuleImportStatus.Changed
                && x.ChangedAction == ChangedRuleImportAction.CreateNew
                && string.IsNullOrWhiteSpace(x.NewRuleName));

        if (invalidCreateAsNew is not null)
        {
            message = $"Enter a new unique rule name for changed rule '{invalidCreateAsNew.Name}'.";
            return;
        }

        if (addImportedRulesToRuleSet && !ResolveRuleSetSelection())
            return;

        Guid? targetClientId = null;
        if (!libraryOnlyImport)
        {
            if (!Guid.TryParse(importClientId, out var parsedClientId))
            {
                message = "Select the client this QuickBooks rule export belongs to.";
                return;
            }

            targetClientId = parsedClientId;
        }

        isImportBusy = true;
        message = null;

        try
        {
            var result = await ImportService.ApplyAsync(organizationId, previewItems, targetClientId);
            var assignedCount = 0;

            if (targetClientId.HasValue)
                assignedCount = await ApplyImportedRulesToClientAsync(targetClientId.Value);

            var groupedCount = 0;

            if (addImportedRulesToRuleSet
                && Guid.TryParse(importRuleSetId, out var ruleSetId))
            {
                await using var db = await DbFactory.CreateDbContextAsync();

                var importedNames = previewItems
                    .Where(x => x.Selected && x.Status is RuleImportStatus.New or RuleImportStatus.Changed)
                    .Select(x => x.EffectiveName)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToArray();

                var ruleIds = await db.MasterRules
                    .Where(x => x.OrganizationId == organizationId && importedNames.Contains(x.Name))
                    .Select(x => x.Id)
                    .ToListAsync();

                foreach (var ruleId in ruleIds)
                {
                    await RuleSetAssignments.AddRuleToSetAsync(ruleSetId, ruleId);
                    groupedCount++;
                }
            }

            message = $"Import complete: {result.Added} reusable rule(s) added and {result.Updated} reusable rule(s) updated."
                + (targetClientId.HasValue ? $" {assignedCount} reusable rule(s) are applied to the selected client." : string.Empty)
                + (result.ClientSpecificAdded > 0 || result.ClientSpecificUpdated > 0
                    ? $" {result.ClientSpecificAdded} client-specific rule(s) added and {result.ClientSpecificUpdated} client-specific rule(s) updated."
                    : string.Empty)
                + (addImportedRulesToRuleSet ? $" {groupedCount} new/changed reusable rule(s) were added to the selected Rule Set." : string.Empty);

            showImportReview = false;
            showImport = false;
            ResetImportState(clearMessage: false);
        }
        catch (Exception ex)
        {
            message = $"Import failed before completion: {ex.Message}";
        }
        finally
        {
            isImportBusy = false;
        }
    }

    private async Task<int> ApplyImportedRulesToClientAsync(Guid clientId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var selectedReusableItems = previewItems
            .Where(x => x.Selected && x.Status is RuleImportStatus.New or RuleImportStatus.Changed or RuleImportStatus.Unchanged)
            .OrderBy(x => x.RowNumber)
            .ToList();

        if (selectedReusableItems.Count == 0)
            return 0;

        var allLibraryRules = await db.MasterRules
            .Where(x => x.OrganizationId == organizationId && x.IsActive)
            .ToListAsync();

        var assignments = await db.ClientRuleAssignments
            .Where(x => x.ClientId == clientId)
            .ToListAsync();

        var clientSpecificRules = await db.ClientRules
            .Where(x => x.ClientId == clientId && x.IsAccountSpecific)
            .ToListAsync();

        var importedRuleIds = new List<Guid>();

        foreach (var item in selectedReusableItems)
        {
            var effectiveName = item.EffectiveName;
            var rule = allLibraryRules.FirstOrDefault(x =>
                string.Equals(x.Name, effectiveName, StringComparison.OrdinalIgnoreCase));

            if (rule is null)
                continue;

            importedRuleIds.Add(rule.Id);

            var assignment = assignments.FirstOrDefault(x => x.MasterRuleId == rule.Id);
            if (assignment is null)
            {
                assignment = new ClientRuleAssignment
                {
                    ClientId = clientId,
                    MasterRuleId = rule.Id,
                    Status = RuleAssignmentStatus.Inherited,
                    IsExplicit = true
                };

                db.ClientRuleAssignments.Add(assignment);
                assignments.Add(assignment);
            }
        }

        var selectedClientSpecificNames = previewItems
            .Where(x => x.Selected && x.Status == RuleImportStatus.ClientSpecific)
            .OrderBy(x => x.RowNumber)
            .Select(x => x.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var orderedImportedRows = previewItems
            .Where(x => x.Selected && x.Status is RuleImportStatus.New or RuleImportStatus.Changed or RuleImportStatus.Unchanged or RuleImportStatus.ClientSpecific)
            .OrderBy(x => x.RowNumber)
            .ToList();

        var priority = 1;
        var prioritizedAssignmentIds = new HashSet<Guid>();
        var prioritizedClientRuleIds = new HashSet<Guid>();

        foreach (var item in orderedImportedRows)
        {
            if (item.Status == RuleImportStatus.ClientSpecific)
            {
                var clientRule = clientSpecificRules.FirstOrDefault(x =>
                    string.Equals(x.Name, item.Name, StringComparison.OrdinalIgnoreCase));

                if (clientRule is not null)
                {
                    clientRule.ExportPriority = priority++;
                    clientRule.ModifiedUtc = DateTime.UtcNow;
                    prioritizedClientRuleIds.Add(clientRule.Id);
                }

                continue;
            }

            var effectiveName = item.EffectiveName;
            var rule = allLibraryRules.FirstOrDefault(x =>
                string.Equals(x.Name, effectiveName, StringComparison.OrdinalIgnoreCase));

            if (rule is null)
                continue;

            var assignment = assignments.FirstOrDefault(x => x.MasterRuleId == rule.Id);
            if (assignment is not null)
            {
                assignment.ExportPriority = priority++;
                assignment.ModifiedUtc = DateTime.UtcNow;
                prioritizedAssignmentIds.Add(assignment.Id);
            }
        }

        foreach (var assignment in assignments
            .Where(x => !prioritizedAssignmentIds.Contains(x.Id))
            .OrderBy(x => x.ExportPriority)
            .ThenBy(x => x.CreatedUtc))
        {
            assignment.ExportPriority = priority++;
        }

        foreach (var clientRule in clientSpecificRules
            .Where(x => !prioritizedClientRuleIds.Contains(x.Id))
            .OrderBy(x => x.ExportPriority)
            .ThenBy(x => x.CreatedUtc))
        {
            clientRule.ExportPriority = priority++;
        }

        await db.SaveChangesAsync();
        return importedRuleIds.Distinct().Count();
    }

    private bool ResolveRuleSetSelection()
    {
        if (Guid.TryParse(importRuleSetId, out _))
            return true;

        var matches = ImportRuleSetOptions.ToList();
        if (matches.Count == 1)
        {
            importRuleSetId = matches[0].Id.ToString();
            return true;
        }

        message = matches.Count == 0
            ? "Choose the Rule Set you want the imported rules added to."
            : "More than one Rule Set matches. Select the Rule Set from the dropdown.";
        return false;
    }

    private void CancelImportReview()
    {
        showImportReview = false;
        showImport = true;
        previewItems.Clear();
        addImportedRulesToRuleSet = false;
        ruleSetSearchText = string.Empty;
        importRuleSetId = string.Empty;
        previewSearchText = string.Empty;
        previewStatusFilter = "all";
        message = null;
    }

    private int CountStatus(RuleImportStatus status) =>
        previewItems.Count(x => x.Status == status);

    private void ClearPreviewFilters()
    {
        previewSearchText = string.Empty;
        previewStatusFilter = "all";
    }

    private void ResetImportState(bool clearMessage = true)
    {
        importClientId = string.Empty;
        importFileName = null;
        importFileSize = 0;
        importFileBytes = null;
        libraryOnlyImport = false;
        addImportedRulesToRuleSet = false;
        ruleSetSearchText = string.Empty;
        importRuleSetId = string.Empty;
        previewSearchText = string.Empty;
        previewStatusFilter = "all";
        previewItems.Clear();

        if (clearMessage)
            message = null;
    }

    private async Task StartExportAsync()
    {
        exportErrors.Clear();

        if (!Guid.TryParse(exportClientId, out var clientId))
        {
            message = "Select the client you want to export.";
            return;
        }

        isExportBusy = true;
        message = null;

        try
        {
            var result = await ExportService.GenerateClientExportAsync(clientId);

            if (!result.Success || result.Content is null || string.IsNullOrWhiteSpace(result.FileName))
            {
                exportErrors.AddRange(result.Errors);
                message = "The export could not be generated.";
                return;
            }

            using var stream = new MemoryStream(result.Content, writable: false);
            using var streamRef = new DotNetStreamReference(stream);

            await JS.InvokeVoidAsync(
                "downloadFileFromStream",
                result.FileName,
                streamRef);

            message = $"Export generated with {result.RuleCount} rule(s).";
        }
        catch (Exception ex)
        {
            message = $"Export failed: {ex.Message}";
        }
        finally
        {
            isExportBusy = false;
        }
    }

    private static string ImportStatusClass(RuleImportStatus status) => status switch
    {
        RuleImportStatus.New => "badge status-badge-active",
        RuleImportStatus.Changed => "badge consistency-issues",
        RuleImportStatus.Unchanged => "badge consistency-none",
        RuleImportStatus.Duplicate => "badge consistency-issues",
        RuleImportStatus.ClientSpecific => "badge status-badge-client-specific",
        RuleImportStatus.Unsupported => "badge status-badge-error",
        _ => "badge consistency-none"
    };

    private static string FormatTransactionType(RuleTransactionType type) => type switch
    {
        RuleTransactionType.CreditCardPayment => "Credit card payment",
        _ => string.Concat(type.ToString().Select((c, i) => i > 0 && char.IsUpper(c) ? " " + c : c.ToString()))
    };

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";

        if (bytes < 1024 * 1024)
            return $"{bytes / 1024d:0.0} KB";

        return $"{bytes / 1024d / 1024d:0.0} MB";
    }
}
