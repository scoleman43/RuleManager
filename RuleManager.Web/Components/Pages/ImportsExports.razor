@page "/imports-exports"

<PageTitle>Imports / Exports</PageTitle>

<h1>Imports / Exports</h1>
<p class="text-muted">Import existing QuickBooks rule files, compare them to master rules, and generate client-specific import files.</p>

<div class="row g-3">
    <div class="col-md-6"><div class="card h-100"><div class="card-body">
        <h5>Import</h5>
        <p class="text-muted">Upload an exported QuickBooks rule workbook for a selected client.</p>
        <button class="btn btn-outline-primary" disabled>Import Rules</button>
    </div></div></div>
    <div class="col-md-6"><div class="card h-100"><div class="card-body">
        <h5>Export</h5>
        <p class="text-muted">Generate a QuickBooks-compatible workbook from selected client rules.</p>
        <button class="btn btn-outline-primary" disabled>Generate Export</button>
    </div></div></div>
</div>
