@page "/rules/new"
@page "/rules/{RuleId:guid}/edit"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using RuleManager.Core.Domain
@using RuleManager.Core.Rules
@using RuleManager.Data
@using RuleManager.Data.Services
@inject IDbContextFactory<RuleManagerDbContext> DbFactory
@inject WorkspaceService Workspace
@inject NavigationManager Navigation

<PageTitle>@EditorTitle</PageTitle>

@if (showCreateAnotherPrompt)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3>Rule created</h3>
            <p class="text-muted mb-4">Would you like to create another rule?</p>
            <div class="d-flex justify-content-center gap-2">
                <button class="btn btn-primary" @onclick="CreateAnother">Yes, Create Another</button>
                <button class="btn btn-outline-secondary" @onclick="ReturnToRules">No, Return to Rules</button>
            </div>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <button class="btn btn-link p-0 mb-2" @onclick="ReturnToRules">← Back to Rules</button>
            <h1>@EditorTitle</h1>
            <p class="text-muted mb-0">@EditorSubtitle</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
    }

    @if (IsClone)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title mb-1">Assign New Rule</h5>
                <div class="text-muted small mb-3">
                    A clone always creates a new reusable rule. You can assign it directly to a client, add it to one or more Rule Sets, do both, or leave it unassigned.
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Direct assignment</label>
                        <select class="form-select" @bind="selectedCloneClientId">
                            <option value="">-- No direct client assignment --</option>
                            @foreach (var option in activeClients)
                            {
                                <option value="@option.Id">@option.Name</option>
                            }
                        </select>
                        @if (CloneClientId.HasValue)
                        {
                            <div class="form-text">This client was selected automatically because the clone was started from its Client Rules page.</div>
                        }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Rule Set</label>
                        <select class="form-select" @bind="selectedCloneRuleSetId">
                            <option value="">-- No Rule Set --</option>
                            @foreach (var set in activeRuleSets)
                            {
                                <option value="@set.Id">@set.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Rule name</label>
                    <input class="form-control" @bind="ruleName" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Money direction</label>
                    <select class="form-select" value="@direction" @onchange="DirectionChanged" disabled="@isSplitRule">
                        <option value="@RuleDirection.MoneyOut">Money out</option>
                        <option value="@RuleDirection.MoneyIn">Money in</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Transaction type</label>
                    <select class="form-select" value="@transactionType" @onchange="TransactionTypeChanged" disabled="@isSplitRule">
                        @foreach (var type in AllowedTransactionTypes)
                        {
                            <option value="@type">@FormatTransactionType(type)</option>
                        }
                    </select>
                </div>

                @if (!IsCreditCardPayment)
                {
                    <div class="col-md-6">
                        <label class="form-label d-block">Rule output</label>
                        <div class="form-check mt-2">
                            <input class="form-check-input"
                                   type="checkbox"
                                   checked="@isSplitRule"
                                   @onchange="SplitRuleChanged"
                                   id="splitRule" />
                            <label class="form-check-label" for="splitRule">Split transaction across multiple categories</label>
                        </div>
                        @if (isSplitRule)
                        {
                            <div class="form-text">Verified QuickBooks split export currently supports Money out / Expense rules.</div>
                        }
                    </div>
                }

                @if (!isSplitRule)
                {
                    @if (IsCreditCardPayment)
                    {
                        <div class="col-md-6">
                            <label class="form-label">Client</label>
                            <select class="form-select" value="@selectedCreditCardClientId" @onchange="CreditCardClientChangedAsync">
                                <option value="">-- Select client --</option>
                                @foreach (var option in activeClients)
                                {
                                    <option value="@option.Id">@option.Name</option>
                                }
                            </select>
                            <div class="form-text">Credit card payment rules are client-specific because the credit card account belongs to one QuickBooks company.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">@(direction == RuleDirection.MoneyOut ? "Credit card" : "Bank account")</label>
                            <select class="form-select" @bind="creditCardAccountName" disabled="@(!CreditCardAccountOptions.Any())">
                                <option value="">@(direction == RuleDirection.MoneyOut ? "-- Select credit card --" : "-- Select bank account --")</option>
                                @foreach (var account in CreditCardAccountOptions)
                                {
                                    <option value="@account">@account</option>
                                }
                            </select>
                            <div class="form-text">
                                @(string.IsNullOrWhiteSpace(selectedCreditCardClientId)
                                    ? "Select a client first."
                                    : CreditCardAccountOptions.Any()
                                        ? direction == RuleDirection.MoneyOut
                                            ? "Credit cards come from the selected client's imported QuickBooks Chart of Accounts."
                                            : "Bank accounts come from the selected client's imported QuickBooks Chart of Accounts."
                                        : direction == RuleDirection.MoneyOut
                                            ? "No credit card accounts are available. Import the selected client's QuickBooks Chart of Accounts first."
                                            : "No bank accounts are available. Import the selected client's QuickBooks Chart of Accounts first.")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Payee</label>
                            <select class="form-select" @bind="payee" disabled="@string.IsNullOrWhiteSpace(selectedCreditCardClientId)">
                                <option value="">-- No payee --</option>
                                @foreach (var option in CreditCardPayeeOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                            <div class="form-text">
                                Payees come from the selected client's imported QuickBooks Vendor list and learned rule references.
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col-md-6">
                            <label class="form-label">Category</label>
                            <div class="input-group">
                                <select class="form-select" @bind="categoryId">
                                    <option value="">-- Select category --</option>
                                    @foreach (var category in CategoryOptions)
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                </select>
                                <button class="btn btn-outline-secondary" type="button" @onclick="ToggleCategoryOverride">
                                    @(showCategoryOverride ? "Cancel" : "Add Override")
                                </button>
                            </div>
                            <div class="form-text">
                                @(clientHasChartOfAccounts
                                    ? "Using categories from this client's imported QuickBooks Chart of Accounts."
                                    : "Using the global category pool. Import this client's QuickBooks Chart of Accounts to use its client-specific category list.")
                            </div>

                            @if (showCategoryOverride)
                            {
                                <div class="alert alert-warning mt-2 mb-0">
                                    <strong>Override only:</strong> RuleManager cannot create categories in QuickBooks.
                                    The category must already exist in QBO and the name must match exactly.
                                    QuickBooks may require manual mapping during import, so verify the imported rule afterward.
                                    <div class="input-group mt-2">
                                        <input class="form-control" @bind="overrideCategoryName" placeholder="Exact QuickBooks category name" />
                                        <button class="btn btn-warning" type="button" @onclick="CreateCategoryOverrideAsync">Add Override</button>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Payee</label>
                            <input class="form-control" @bind="payee" />
                        </div>
                    }
                }

                <div class="col-md-6">
                    <label class="form-label">Condition logic</label>
                    <select class="form-select" @bind="conditionLogic">
                        <option value="all">Match all conditions</option>
                        <option value="any">Match any condition</option>
                    </select>
                </div>

                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" @bind="autoAdd" id="autoAddRule" disabled="@isSplitRule" />
                        <label class="form-check-label" for="autoAddRule">Auto-add matching transactions</label>
                    </div>
                </div>
            </div>

            <hr />

            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0">Conditions</h6>
                <button class="btn btn-sm btn-outline-primary" @onclick="AddCondition">Add Condition</button>
            </div>

            @for (var i = 0; i < conditions.Count; i++)
            {
                var index = i;
                var condition = conditions[index];

                <div class="row g-2 mb-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Field</label>
                        <select class="form-select" value="@condition.Field" @onchange="e => ConditionFieldChanged(index, e)">
                            <option value="@RuleMatchField.BankText">Bank text</option>
                            <option value="@RuleMatchField.Description">Description</option>
                            <option value="@RuleMatchField.Amount">Amount</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Operator</label>
                        <select class="form-select" @bind="condition.Operator">
                            @foreach (var op in MasterRulePolicy.GetAllowedOperators(condition.Field))
                            {
                                <option value="@op">@FormatOperator(op)</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-5">
                        <label class="form-label">Value</label>
                        <input class="form-control" @bind="condition.Value" />
                    </div>

                    <div class="col-md-1">
                        <button class="btn btn-outline-danger w-100" @onclick="() => RemoveCondition(index)" disabled="@(conditions.Count == 1)">×</button>
                    </div>
                </div>
            }

            @if (isSplitRule)
            {
                <hr />
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <h6 class="mb-0">Split allocations</h6>
                        <div class="small text-muted">Use percentage lines totaling 100%, or fixed amounts with exactly one remainder line.</div>
                    </div>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddSplitLine">Add Split Line</button>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Split method</label>
                        <select class="form-select" value="@splitType" @onchange="SplitTypeChanged">
                            <option value="@QuickBooksSplitType.Percentage">Percentage</option>
                            <option value="@QuickBooksSplitType.Amount">Amount + remainder</option>
                        </select>
                    </div>
                </div>

                @for (var i = 0; i < splitLines.Count; i++)
                {
                    var splitIndex = i;
                    var line = splitLines[splitIndex];

                    <div class="row g-2 mb-2 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label">Category</label>
                            <select class="form-select" @bind="line.CategoryName">
                                <option value="">-- Select category --</option>
                                @foreach (var categoryName in SplitCategoryOptions(line))
                                {
                                    <option value="@categoryName">@categoryName</option>
                                }
                            </select>
                        </div>

                        @if (splitType == QuickBooksSplitType.Percentage)
                        {
                            <div class="col-md-4">
                                <label class="form-label">Percentage</label>
                                <div class="input-group">
                                    <input class="form-control" @bind="line.Value" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-4">
                                <label class="form-label">Amount</label>
                                <input class="form-control" @bind="line.Value" disabled="@line.IsRemainder" />
                            </div>
                            <div class="col-md-2">
                                <div class="form-check mb-2">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           checked="@line.IsRemainder"
                                           @onchange="e => SplitRemainderChanged(splitIndex, e)" />
                                    <label class="form-check-label">Remainder</label>
                                </div>
                            </div>
                        }

                        <div class="col-md-1">
                            <button class="btn btn-outline-danger w-100"
                                    @onclick="() => RemoveSplitLine(splitIndex)"
                                    disabled="@(splitLines.Count <= 2)">×</button>
                        </div>
                    </div>
                }
            }

            @if (conditions.Any(x => x.Field == RuleMatchField.Amount) && direction == RuleDirection.MoneyIn)
            {
                <div class="alert alert-warning mt-3 mb-0">
                    QuickBooks Money in Amount export has not yet been verified. Money out Amount mappings are verified.
                </div>
            }

            <div class="alert alert-secondary mt-3">
                Rules can be added to one or more Rule Sets or assigned directly to specific clients.
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveAsync">Save Rule</button>
                <button class="btn btn-outline-secondary" @onclick="ReturnToRules">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? RuleId { get; set; }
    [SupplyParameterFromQuery(Name = "cloneFrom")] public Guid? CloneFrom { get; set; }
    [SupplyParameterFromQuery(Name = "clientId")] public Guid? CloneClientId { get; set; }

    private Guid organizationId;
    private readonly List<Category> categories = new();
    private readonly List<ClientReference> clientCategoryReferences = new();
    private readonly List<ClientReference> creditCardClientReferences = new();
    private readonly List<Client> activeClients = new();
    private readonly List<RuleSet> activeRuleSets = new();
    private readonly List<RuleCondition> conditions = new();
    private bool clientHasChartOfAccounts;

    private string ruleName = string.Empty;
    private RuleDirection direction = RuleDirection.MoneyOut;
    private RuleTransactionType transactionType = RuleTransactionType.Expense;
    private string categoryId = string.Empty;
    private string payee = string.Empty;
    private string conditionLogic = "all";
    private bool autoAdd;
    private bool isError;
    private string? message;
    private bool showCreateAnotherPrompt;
    private bool showCategoryOverride;
    private string overrideCategoryName = string.Empty;
    private bool loadedReadOnlyImport;
    private bool isSplitRule;
    private string selectedCloneClientId = string.Empty;
    private string selectedCloneRuleSetId = string.Empty;
    private string selectedCreditCardClientId = string.Empty;
    private string creditCardAccountName = string.Empty;
    private QuickBooksSplitType splitType = QuickBooksSplitType.Percentage;
    private readonly List<QuickBooksSplitLine> splitLines = new();

    private bool IsClone => CloneFrom.HasValue;
    private string EditorTitle => IsClone
        ? "Clone Rule"
        : RuleId.HasValue
            ? "Edit Rule"
            : "New Rule";

    private string EditorSubtitle => IsClone
        ? "Create a new reusable rule from an existing rule, then choose where it should be assigned."
        : "Create or update a reusable rule.";

    private bool IsCreditCardPayment =>
        transactionType == RuleTransactionType.CreditCardPayment;

    private IReadOnlyList<RuleTransactionType> AllowedTransactionTypes =>
        MasterRulePolicy.GetAllowedTransactionTypes(direction)
            .Where(x => x != RuleTransactionType.CreditCardPayment || (!RuleId.HasValue && !IsClone))
            .ToList();

    private IEnumerable<string> CreditCardAccountOptions =>
        creditCardClientReferences
            .Where(x => x.Type == ClientReferenceType.Account
                && x.IsActive
                && (direction == RuleDirection.MoneyOut
                    ? string.Equals(x.QuickBooksAccountType, "Credit Card", StringComparison.OrdinalIgnoreCase)
                    : string.Equals(x.QuickBooksAccountType, "Bank", StringComparison.OrdinalIgnoreCase)))
            .Select(x => x.Name)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<string> CreditCardPayeeOptions =>
        creditCardClientReferences
            .Where(x => x.Type == ClientReferenceType.Payee && x.IsActive)
            .Select(x => x.Name)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<Category> CategoryOptions
    {
        get
        {
            var active = categories.Where(x => x.IsActive);

            if (!CloneClientId.HasValue || !clientHasChartOfAccounts)
                return active.OrderBy(x => x.Name);

            var allowedNames = clientCategoryReferences
                .Where(x => x.Type == ClientReferenceType.Category && x.IsActive)
                .Select(x => x.Name)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            return active
                .Where(x => allowedNames.Contains(x.Name)
                    || (!string.IsNullOrWhiteSpace(categoryId)
                        && Guid.TryParse(categoryId, out var selectedId)
                        && x.Id == selectedId))
                .OrderBy(x => x.Name);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        organizationId = await Workspace.GetOrCreateDefaultOrganizationIdAsync();
        await LoadCategoriesAsync();
        await LoadClientCategoryReferencesAsync();
        await LoadClientsAsync();
        await LoadRuleSetsAsync();

        if (RuleId.HasValue)
            await LoadRuleAsync(RuleId.Value);
        else if (CloneFrom.HasValue)
            await LoadCloneAsync(CloneFrom.Value);
        else
            ResetForm();
    }

    private async Task LoadCategoriesAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        categories.Clear();
        categories.AddRange(await db.Categories
            .Where(x => x.OrganizationId == organizationId)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());
    }

    private async Task LoadClientCategoryReferencesAsync()
    {
        clientCategoryReferences.Clear();
        clientHasChartOfAccounts = false;

        if (!CloneClientId.HasValue)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();

        clientCategoryReferences.AddRange(await db.ClientReferences
            .Where(x => x.ClientId == CloneClientId.Value && x.IsActive)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());

        clientHasChartOfAccounts = clientCategoryReferences.Any(x =>
            x.Source == ClientReferenceSource.ChartOfAccountsImport);
    }

    private async Task LoadClientsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        activeClients.Clear();
        activeClients.AddRange(await db.Clients
            .Where(x => x.OrganizationId == organizationId && x.IsActive)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());
    }

    private async Task LoadRuleSetsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        activeRuleSets.Clear();
        activeRuleSets.AddRange(await db.RuleSets
            .Where(x => x.OrganizationId == organizationId && x.IsActive)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());
    }

    private async Task LoadCloneAsync(Guid sourceRuleId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var source = await db.MasterRules
            .AsNoTracking()
            .SingleOrDefaultAsync(x => x.Id == sourceRuleId && x.OrganizationId == organizationId);

        if (source is null)
        {
            Navigation.NavigateTo("/rules");
            return;
        }

        ResetForm();
        selectedCloneClientId = CloneClientId?.ToString() ?? string.Empty;

        LoadRuleValues(source);
        ruleName = $"{source.Name} - Copy";
        loadedReadOnlyImport = source.IsReadOnlyImport && !isSplitRule;
    }

    private void LoadRuleValues(RuleBase rule)
    {
        ruleName = rule.Name;
        direction = rule.Direction;
        transactionType = rule.TransactionType;
        categoryId = rule.CategoryId?.ToString() ?? string.Empty;
        payee = rule.Payee ?? string.Empty;
        conditionLogic = rule.MatchAllConditions ? "all" : "any";
        autoAdd = rule.AutoAdd;

        splitLines.Clear();
        isSplitRule = QuickBooksSplitRuleCodec.TryParse(rule.OriginalOutputsJson, out var splitDefinition);
        if (isSplitRule && splitDefinition is not null)
        {
            splitType = splitDefinition.Type;
            splitLines.AddRange(splitDefinition.Lines.Select(x => new QuickBooksSplitLine
            {
                CategoryName = x.CategoryName,
                Value = x.Value,
                IsRemainder = x.IsRemainder
            }));
        }

        conditions.Clear();
        conditions.AddRange(rule.Conditions.Select(x => new RuleCondition
        {
            Field = x.Field,
            Operator = x.Operator,
            Value = x.Value
        }));

        if (conditions.Count == 0)
            conditions.Add(NewCondition());

        message = null;
        isError = false;
        showCreateAnotherPrompt = false;
        showCategoryOverride = false;
        overrideCategoryName = string.Empty;
    }

    private async Task LoadRuleAsync(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var rule = await db.MasterRules
            .AsNoTracking()
            .SingleOrDefaultAsync(x => x.Id == id && x.OrganizationId == organizationId);

        if (rule is null)
        {
            Navigation.NavigateTo("/rules");
            return;
        }

        LoadRuleValues(rule);
        loadedReadOnlyImport = rule.IsReadOnlyImport && !isSplitRule;
    }

    private void ResetForm()
    {
        ruleName = string.Empty;
        direction = RuleDirection.MoneyOut;
        transactionType = RuleTransactionType.Expense;
        categoryId = string.Empty;
        payee = string.Empty;
        conditionLogic = "all";
        autoAdd = false;
        message = null;
        isError = false;
        showCreateAnotherPrompt = false;
        showCategoryOverride = false;
        overrideCategoryName = string.Empty;
        loadedReadOnlyImport = false;
        isSplitRule = false;
        selectedCloneClientId = string.Empty;
        selectedCloneRuleSetId = string.Empty;
        selectedCreditCardClientId = string.Empty;
        creditCardAccountName = string.Empty;
        creditCardClientReferences.Clear();
        splitType = QuickBooksSplitType.Percentage;
        splitLines.Clear();

        conditions.Clear();
        conditions.Add(NewCondition());
    }

    private void CreateAnother()
    {
        ResetForm();
        Navigation.NavigateTo("/rules/new", replace: true);
    }

    private void ReturnToRules()
    {
        if (IsClone && CloneClientId.HasValue)
            Navigation.NavigateTo($"/clients/{CloneClientId.Value}/rules");
        else
            Navigation.NavigateTo("/rules");
    }

    private void ToggleCategoryOverride()
    {
        showCategoryOverride = !showCategoryOverride;
        if (!showCategoryOverride)
            overrideCategoryName = string.Empty;
    }

    private async Task CreateCategoryOverrideAsync()
    {
        string normalized;
        try
        {
            normalized = CategoryName.Normalize(overrideCategoryName);
        }
        catch (ArgumentException ex)
        {
            SetError(ex.Message);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var existing = await db.Categories.FirstOrDefaultAsync(x =>
            x.OrganizationId == organizationId &&
            x.Name.ToLower() == normalized.ToLower());

        if (existing is null)
        {
            existing = new Category
            {
                OrganizationId = organizationId,
                Name = normalized
            };
            db.Categories.Add(existing);
        }
        else if (!existing.IsActive)
        {
            existing.IsActive = true;
            existing.ModifiedUtc = DateTime.UtcNow;
        }

        await db.SaveChangesAsync();
        await LoadCategoriesAsync();

        categoryId = existing.Id.ToString();
        showCategoryOverride = false;
        overrideCategoryName = string.Empty;
        isError = false;
        message = $"Category override '{normalized}' added. Confirm this exact category already exists in QuickBooks before importing the exported rule.";
    }

    private void AddCondition() => conditions.Add(NewCondition());

    private void RemoveCondition(int index)
    {
        if (conditions.Count > 1 && index >= 0 && index < conditions.Count)
            conditions.RemoveAt(index);
    }

    private void SplitRuleChanged(ChangeEventArgs e)
    {
        isSplitRule = e.Value is bool value && value;

        if (isSplitRule)
        {
            direction = RuleDirection.MoneyOut;
            transactionType = RuleTransactionType.Expense;
            categoryId = string.Empty;
            payee = string.Empty;
            autoAdd = false;

            if (splitLines.Count < 2)
            {
                splitLines.Clear();
                splitLines.Add(new QuickBooksSplitLine());
                splitLines.Add(new QuickBooksSplitLine());
            }
        }
    }

    private void SplitTypeChanged(ChangeEventArgs e)
    {
        if (!Enum.TryParse<QuickBooksSplitType>(e.Value?.ToString(), out var parsed))
            return;

        splitType = parsed;

        foreach (var line in splitLines)
        {
            line.IsRemainder = false;
            if (splitType == QuickBooksSplitType.Percentage && string.IsNullOrWhiteSpace(line.Value))
                line.Value = string.Empty;
        }

        if (splitType == QuickBooksSplitType.Amount && splitLines.Count > 0)
        {
            splitLines[^1].IsRemainder = true;
            splitLines[^1].Value = string.Empty;
        }
    }

    private void AddSplitLine() => splitLines.Add(new QuickBooksSplitLine());

    private void RemoveSplitLine(int index)
    {
        if (splitLines.Count > 2 && index >= 0 && index < splitLines.Count)
            splitLines.RemoveAt(index);
    }

    private void SplitRemainderChanged(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= splitLines.Count)
            return;

        var isRemainder = e.Value is bool value && value;

        if (isRemainder)
        {
            foreach (var line in splitLines)
                line.IsRemainder = false;

            splitLines[index].IsRemainder = true;
            splitLines[index].Value = string.Empty;
        }
        else
        {
            splitLines[index].IsRemainder = false;
        }
    }

    private IEnumerable<string> SplitCategoryOptions(QuickBooksSplitLine line)
    {
        var names = CategoryOptions
            .Select(x => x.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(line.CategoryName))
            names.Add(line.CategoryName);

        return names.OrderBy(x => x, StringComparer.OrdinalIgnoreCase);
    }

    private QuickBooksSplitDefinition BuildSplitDefinition() => new()
    {
        Type = splitType,
        Lines = splitLines.Select(x => new QuickBooksSplitLine
        {
            CategoryName = x.CategoryName.Trim(),
            Value = x.Value.Trim(),
            IsRemainder = x.IsRemainder
        }).ToList()
    };

    private async Task TransactionTypeChanged(ChangeEventArgs e)
    {
        if (!Enum.TryParse<RuleTransactionType>(e.Value?.ToString(), out var parsed))
            return;

        transactionType = parsed;

        if (IsCreditCardPayment)
        {
            isSplitRule = false;
            categoryId = string.Empty;
            payee = string.Empty;
            selectedCreditCardClientId = string.Empty;
            creditCardAccountName = string.Empty;
            creditCardClientReferences.Clear();
        }
    }

    private async Task CreditCardClientChangedAsync(ChangeEventArgs e)
    {
        selectedCreditCardClientId = e.Value?.ToString() ?? string.Empty;
        creditCardAccountName = string.Empty;
        payee = string.Empty;
        creditCardClientReferences.Clear();

        if (!Guid.TryParse(selectedCreditCardClientId, out var clientId))
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        creditCardClientReferences.AddRange(await db.ClientReferences
            .Where(x => x.ClientId == clientId && x.IsActive)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());
    }

    private void DirectionChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<RuleDirection>(e.Value?.ToString(), out var parsed))
        {
            direction = parsed;
            if (!AllowedTransactionTypes.Contains(transactionType))
                transactionType = AllowedTransactionTypes[0];

            if (IsCreditCardPayment)
                creditCardAccountName = string.Empty;
        }
    }

    private void ConditionFieldChanged(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= conditions.Count)
            return;

        if (Enum.TryParse<RuleMatchField>(e.Value?.ToString(), out var parsed))
        {
            conditions[index].Field = parsed;
            conditions[index].Operator = MasterRulePolicy.GetAllowedOperators(parsed)[0];
        }
    }

    private async Task SaveAsync()
    {
        if (loadedReadOnlyImport)
        {
            SetError("This imported QuickBooks rule is preserved exactly for export and cannot be edited yet.");
            return;
        }

        var name = ruleName.Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            SetError("Rule name is required.");
            return;
        }

        if (conditions.Count == 0 || conditions.Any(x => string.IsNullOrWhiteSpace(x.Value)))
        {
            SetError("Every rule needs at least one condition with a value.");
            return;
        }

        if (!MasterRulePolicy.CanCreate(direction, transactionType))
        {
            SetError("That transaction type is not valid for the selected money direction.");
            return;
        }

        if (IsCreditCardPayment)
        {
            await SaveCreditCardPaymentRuleAsync(name);
            return;
        }

        QuickBooksSplitDefinition? splitDefinition = null;

        if (isSplitRule)
        {
            if (direction != RuleDirection.MoneyOut || transactionType != RuleTransactionType.Expense)
            {
                SetError("Split rules are currently verified only for Money out / Expense.");
                return;
            }

            splitDefinition = BuildSplitDefinition();
            var splitError = QuickBooksSplitRuleCodec.Validate(splitDefinition);
            if (splitError is not null)
            {
                SetError(splitError);
                return;
            }
        }

        Guid? selectedCategoryId = null;
        string? selectedCategoryName = null;

        if (!isSplitRule && !string.IsNullOrWhiteSpace(categoryId))
        {
            if (!Guid.TryParse(categoryId, out var parsedCategoryId))
            {
                SetError("The selected category is invalid.");
                return;
            }

            selectedCategoryId = parsedCategoryId;
            selectedCategoryName = categories.FirstOrDefault(x => x.Id == parsedCategoryId)?.Name;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var isNewMasterRule = !RuleId.HasValue;

        if (isNewMasterRule)
        {
            var duplicateName = await db.MasterRules.AnyAsync(x =>
                x.OrganizationId == organizationId
                && x.Name.ToLower() == name.ToLower());

            if (duplicateName)
            {
                SetError($"A reusable rule named '{name}' already exists. Use a different name for the cloned rule.");
                return;
            }
        }

        MasterRule masterEntity;
        if (RuleId.HasValue)
        {
            masterEntity = await db.MasterRules.SingleAsync(x => x.Id == RuleId.Value);
        }
        else
        {
            masterEntity = new MasterRule
            {
                OrganizationId = organizationId
            };
            db.MasterRules.Add(masterEntity);
        }

        ApplyFormValues(masterEntity, name, selectedCategoryId, selectedCategoryName, splitDefinition);

        if (!string.IsNullOrWhiteSpace(masterEntity.ImportedQuickBooksRuleName)
            && !string.IsNullOrWhiteSpace(masterEntity.ImportedBaselineJson))
        {
            masterEntity.IsModifiedSinceImport =
                !RuleImportSnapshot.MatchesBaseline(masterEntity);
        }

        await db.SaveChangesAsync();

        if (IsClone)
        {
            if (Guid.TryParse(selectedCloneClientId, out var cloneClientId))
            {
                var currentMax = Math.Max(
                    await db.ClientRuleAssignments
                        .Where(x => x.ClientId == cloneClientId)
                        .Select(x => (int?)x.ExportPriority)
                        .MaxAsync() ?? 0,
                    await db.ClientRules
                        .Where(x => x.ClientId == cloneClientId)
                        .Select(x => (int?)x.ExportPriority)
                        .MaxAsync() ?? 0);

                db.ClientRuleAssignments.Add(new ClientRuleAssignment
                {
                    ClientId = cloneClientId,
                    MasterRuleId = masterEntity.Id,
                    IsExplicit = true,
                    Status = RuleAssignmentStatus.Inherited,
                    ExportPriority = currentMax + 1
                });
            }

            if (Guid.TryParse(selectedCloneRuleSetId, out var cloneRuleSetId))
            {
                var ruleSetExists = await db.RuleSets.AnyAsync(x =>
                    x.Id == cloneRuleSetId
                    && x.OrganizationId == organizationId
                    && x.IsActive);

                if (!ruleSetExists)
                {
                    SetError("The selected Rule Set is no longer available.");
                    return;
                }

                var nextOrder = await db.RuleSetRules
                    .Where(x => x.RuleSetId == cloneRuleSetId)
                    .Select(x => (int?)x.SortOrder)
                    .MaxAsync() ?? 0;

                db.RuleSetRules.Add(new RuleSetRule
                {
                    RuleSetId = cloneRuleSetId,
                    MasterRuleId = masterEntity.Id,
                    SortOrder = nextOrder + 1
                });
            }

            await db.SaveChangesAsync();

            if (CloneClientId.HasValue)
            {
                Navigation.NavigateTo($"/clients/{CloneClientId.Value}/rules");
                return;
            }

            Navigation.NavigateTo("/rules");
            return;
        }

        if (isNewMasterRule)
        {
            showCreateAnotherPrompt = true;
            message = null;
            isError = false;
        }
        else
        {
            Navigation.NavigateTo("/rules");
        }
    }

    private async Task SaveCreditCardPaymentRuleAsync(string name)
    {
        if (!Guid.TryParse(selectedCreditCardClientId, out var clientId))
        {
            SetError("Select the client for this credit card payment rule.");
            return;
        }

        if (string.IsNullOrWhiteSpace(creditCardAccountName))
        {
            SetError(direction == RuleDirection.MoneyOut
                ? "Select the credit card account."
                : "Select the bank account.");
            return;
        }

        if (!CreditCardAccountOptions.Contains(creditCardAccountName, StringComparer.OrdinalIgnoreCase))
        {
            SetError(direction == RuleDirection.MoneyOut
                ? "The selected credit card is not available in this client's imported Chart of Accounts."
                : "The selected bank account is not available in this client's imported Chart of Accounts.");
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var duplicateClientRule = await db.ClientRules.AnyAsync(x =>
            x.ClientId == clientId && x.Name.ToLower() == name.ToLower());

        if (duplicateClientRule)
        {
            SetError($"A client-specific rule named '{name}' already exists for the selected client.");
            return;
        }

        var assignedRuleIds = await db.ClientRuleAssignments
            .Where(x => x.ClientId == clientId)
            .Select(x => x.MasterRuleId)
            .ToListAsync();

        var duplicateReusableRule = await db.MasterRules.AnyAsync(x =>
            assignedRuleIds.Contains(x.Id)
            && x.IsActive
            && x.Name.ToLower() == name.ToLower());

        if (duplicateReusableRule)
        {
            SetError($"An assigned reusable rule named '{name}' already exists for the selected client. Use a unique QuickBooks rule name.");
            return;
        }

        var assignmentMax = await db.ClientRuleAssignments
            .Where(x => x.ClientId == clientId)
            .Select(x => (int?)x.ExportPriority)
            .MaxAsync() ?? 0;

        var clientRuleMax = await db.ClientRules
            .Where(x => x.ClientId == clientId)
            .Select(x => (int?)x.ExportPriority)
            .MaxAsync() ?? 0;

        var entity = new ClientRule
        {
            ClientId = clientId,
            Name = name,
            Direction = direction,
            TransactionType = RuleTransactionType.CreditCardPayment,
            CategoryName = creditCardAccountName.Trim(),
            Payee = NullIfWhiteSpace(payee),
            MatchAllConditions = conditionLogic == "all",
            AutoAdd = autoAdd,
            IsAccountSpecific = true,
            IsReadOnlyImport = false,
            IsModifiedSinceImport = false,
            ExportPriority = Math.Max(assignmentMax, clientRuleMax) + 1,
            Conditions = conditions.Select(x => new RuleCondition
            {
                Field = x.Field,
                Operator = x.Operator,
                Value = x.Value.Trim()
            }).ToList()
        };

        db.ClientRules.Add(entity);
        await db.SaveChangesAsync();

        Navigation.NavigateTo($"/clients/{clientId}/rules");
    }

    private void ApplyFormValues(
        RuleBase entity,
        string name,
        Guid? selectedCategoryId,
        string? selectedCategoryName,
        QuickBooksSplitDefinition? splitDefinition)
    {
        entity.Name = name;
        entity.Direction = direction;
        entity.TransactionType = transactionType;
        entity.CategoryId = isSplitRule ? null : selectedCategoryId;
        entity.CategoryName = isSplitRule ? null : selectedCategoryName;
        entity.Payee = isSplitRule ? null : NullIfWhiteSpace(payee);
        entity.MatchAllConditions = conditionLogic == "all";
        entity.AutoAdd = isSplitRule ? false : autoAdd;
        entity.IsAccountSpecific = false;
        entity.IsReadOnlyImport = false;
        entity.OriginalConditionsJson = null;
        entity.OriginalOutputsJson = isSplitRule && splitDefinition is not null
            ? QuickBooksSplitRuleCodec.Serialize(splitDefinition)
            : null;
        entity.Conditions = conditions.Select(x => new RuleCondition
        {
            Field = x.Field,
            Operator = x.Operator,
            Value = x.Value.Trim()
        }).ToList();
        entity.ModifiedUtc = DateTime.UtcNow;
    }

    private void SetError(string text)
    {
        isError = true;
        message = text;
    }

    private static RuleCondition NewCondition() => new()
    {
        Field = RuleMatchField.BankText,
        Operator = RuleMatchOperator.Contains,
        Value = string.Empty
    };

    private static string? NullIfWhiteSpace(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string FormatTransactionType(RuleTransactionType type) => type switch
    {
        RuleTransactionType.CreditCardPayment => "Credit card payment",
        _ => string.Concat(type.ToString().Select((c, i) => i > 0 && char.IsUpper(c) ? " " + c : c.ToString()))
    };

    private static string FormatOperator(RuleMatchOperator op) => op switch
    {
        RuleMatchOperator.DoesNotContain => "Doesn't contain",
        RuleMatchOperator.DoesNotEqual => "Doesn't equal",
        RuleMatchOperator.StartsWith => "Starts with",
        RuleMatchOperator.EndsWith => "Ends with",
        RuleMatchOperator.GreaterThan => "Is greater than",
        RuleMatchOperator.LessThan => "Is less than",
        _ => op.ToString()
    };
}
