@page "/rules/new"
@page "/rules/{RuleId:guid}/edit"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using RuleManager.Core.Domain
@using RuleManager.Core.Rules
@using RuleManager.Data
@using RuleManager.Data.Services
@inject IDbContextFactory<RuleManagerDbContext> DbFactory
@inject WorkspaceService Workspace
@inject NavigationManager Navigation

<PageTitle>@(RuleId.HasValue ? "Edit Rule" : "New Rule")</PageTitle>

@if (showCreateAnotherPrompt)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3>Rule created</h3>
            <p class="text-muted mb-4">Would you like to create another rule?</p>
            <div class="d-flex justify-content-center gap-2">
                <button class="btn btn-primary" @onclick="CreateAnother">Yes, Create Another</button>
                <button class="btn btn-outline-secondary" @onclick="ReturnToRules">No, Return to Rules</button>
            </div>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <button class="btn btn-link p-0 mb-2" @onclick="ReturnToRules">← Back to Rules</button>
            <h1>@(RuleId.HasValue ? "Edit Rule" : "New Rule")</h1>
            <p class="text-muted mb-0">Create or update a reusable rule.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
    }

    <div class="card">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Rule name</label>
                    <input class="form-control" @bind="ruleName" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Money direction</label>
                    <select class="form-select" value="@direction" @onchange="DirectionChanged" disabled="@isSplitRule">
                        <option value="@RuleDirection.MoneyOut">Money out</option>
                        <option value="@RuleDirection.MoneyIn">Money in</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Transaction type</label>
                    <select class="form-select" @bind="transactionType" disabled="@isSplitRule">
                        @foreach (var type in AllowedTransactionTypes)
                        {
                            <option value="@type">@FormatTransactionType(type)</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label d-block">Rule output</label>
                    <div class="form-check mt-2">
                        <input class="form-check-input"
                               type="checkbox"
                               checked="@isSplitRule"
                               @onchange="SplitRuleChanged"
                               id="splitRule" />
                        <label class="form-check-label" for="splitRule">Split transaction across multiple categories</label>
                    </div>
                    @if (isSplitRule)
                    {
                        <div class="form-text">Verified QuickBooks split export currently supports Money out / Expense rules.</div>
                    }
                </div>

                @if (!isSplitRule)
                {
                    <div class="col-md-6">
                        <label class="form-label">Category</label>
                        <select class="form-select" @bind="categoryId">
                            <option value="">-- Select category --</option>
                            @foreach (var category in categories.Where(x => x.IsActive))
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                        <div class="form-text">
                            Categories come from QuickBooks rule imports. Create new categories in QuickBooks first, then import rules that use them into RuleManager.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Payee</label>
                        <input class="form-control" @bind="payee" />
                    </div>
                }

                <div class="col-md-6">
                    <label class="form-label">Condition logic</label>
                    <select class="form-select" @bind="conditionLogic">
                        <option value="all">Match all conditions</option>
                        <option value="any">Match any condition</option>
                    </select>
                </div>

                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" @bind="autoAdd" id="autoAddRule" disabled="@isSplitRule" />
                        <label class="form-check-label" for="autoAddRule">Auto-add matching transactions</label>
                    </div>
                </div>
            </div>

            <hr />

            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0">Conditions</h6>
                <button class="btn btn-sm btn-outline-primary" @onclick="AddCondition">Add Condition</button>
            </div>

            @for (var i = 0; i < conditions.Count; i++)
            {
                var index = i;
                var condition = conditions[index];

                <div class="row g-2 mb-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Field</label>
                        <select class="form-select" value="@condition.Field" @onchange="e => ConditionFieldChanged(index, e)">
                            <option value="@RuleMatchField.BankText">Bank text</option>
                            <option value="@RuleMatchField.Description">Description</option>
                            <option value="@RuleMatchField.Amount">Amount</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Operator</label>
                        <select class="form-select" @bind="condition.Operator">
                            @foreach (var op in MasterRulePolicy.GetAllowedOperators(condition.Field))
                            {
                                <option value="@op">@FormatOperator(op)</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-5">
                        <label class="form-label">Value</label>
                        <input class="form-control" @bind="condition.Value" />
                    </div>

                    <div class="col-md-1">
                        <button class="btn btn-outline-danger w-100" @onclick="() => RemoveCondition(index)" disabled="@(conditions.Count == 1)">×</button>
                    </div>
                </div>
            }

            @if (isSplitRule)
            {
                <hr />
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <h6 class="mb-0">Split allocations</h6>
                        <div class="small text-muted">Use percentage lines totaling 100%, or fixed amounts with exactly one remainder line.</div>
                    </div>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddSplitLine">Add Split Line</button>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Split method</label>
                        <select class="form-select" value="@splitType" @onchange="SplitTypeChanged">
                            <option value="@QuickBooksSplitType.Percentage">Percentage</option>
                            <option value="@QuickBooksSplitType.Amount">Amount + remainder</option>
                        </select>
                    </div>
                </div>

                @for (var i = 0; i < splitLines.Count; i++)
                {
                    var splitIndex = i;
                    var line = splitLines[splitIndex];

                    <div class="row g-2 mb-2 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label">Category</label>
                            <select class="form-select" @bind="line.CategoryName">
                                <option value="">-- Select category --</option>
                                @foreach (var categoryName in SplitCategoryOptions(line))
                                {
                                    <option value="@categoryName">@categoryName</option>
                                }
                            </select>
                        </div>

                        @if (splitType == QuickBooksSplitType.Percentage)
                        {
                            <div class="col-md-4">
                                <label class="form-label">Percentage</label>
                                <div class="input-group">
                                    <input class="form-control" @bind="line.Value" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-4">
                                <label class="form-label">Amount</label>
                                <input class="form-control" @bind="line.Value" disabled="@line.IsRemainder" />
                            </div>
                            <div class="col-md-2">
                                <div class="form-check mb-2">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           checked="@line.IsRemainder"
                                           @onchange="e => SplitRemainderChanged(splitIndex, e)" />
                                    <label class="form-check-label">Remainder</label>
                                </div>
                            </div>
                        }

                        <div class="col-md-1">
                            <button class="btn btn-outline-danger w-100"
                                    @onclick="() => RemoveSplitLine(splitIndex)"
                                    disabled="@(splitLines.Count <= 2)">×</button>
                        </div>
                    </div>
                }
            }

            @if (conditions.Any(x => x.Field == RuleMatchField.Amount) && direction == RuleDirection.MoneyIn)
            {
                <div class="alert alert-warning mt-3 mb-0">
                    QuickBooks Money in Amount export has not yet been verified. Money out Amount mappings are verified.
                </div>
            }

            <div class="alert alert-secondary mt-3">
                Rules can be added to one or more Rule Sets or assigned directly to specific clients.
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveAsync">Save Rule</button>
                <button class="btn btn-outline-secondary" @onclick="ReturnToRules">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? RuleId { get; set; }

    private Guid organizationId;
    private readonly List<Category> categories = new();
    private readonly List<RuleCondition> conditions = new();

    private string ruleName = string.Empty;
    private RuleDirection direction = RuleDirection.MoneyOut;
    private RuleTransactionType transactionType = RuleTransactionType.Expense;
    private string categoryId = string.Empty;
    private string payee = string.Empty;
    private string conditionLogic = "all";
    private bool autoAdd;
    private bool isError;
    private string? message;
    private bool showCreateAnotherPrompt;
    private bool loadedReadOnlyImport;
    private bool isSplitRule;
    private QuickBooksSplitType splitType = QuickBooksSplitType.Percentage;
    private readonly List<QuickBooksSplitLine> splitLines = new();

    private IReadOnlyList<RuleTransactionType> AllowedTransactionTypes =>
        MasterRulePolicy.GetAllowedTransactionTypes(direction);

    protected override async Task OnParametersSetAsync()
    {
        organizationId = await Workspace.GetOrCreateDefaultOrganizationIdAsync();
        await LoadCategoriesAsync();

        if (RuleId.HasValue)
            await LoadRuleAsync(RuleId.Value);
        else
            ResetForm();
    }

    private async Task LoadCategoriesAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        categories.Clear();
        categories.AddRange(await db.Categories
            .Where(x => x.OrganizationId == organizationId)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());
    }

    private async Task LoadRuleAsync(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var rule = await db.MasterRules
            .AsNoTracking()
            .SingleOrDefaultAsync(x => x.Id == id && x.OrganizationId == organizationId);

        if (rule is null)
        {
            Navigation.NavigateTo("/rules");
            return;
        }

        ruleName = rule.Name;
        direction = rule.Direction;
        transactionType = rule.TransactionType;
        categoryId = rule.CategoryId?.ToString() ?? string.Empty;
        payee = rule.Payee ?? string.Empty;
        conditionLogic = rule.MatchAllConditions ? "all" : "any";
        autoAdd = rule.AutoAdd;

        splitLines.Clear();
        isSplitRule = QuickBooksSplitRuleCodec.TryParse(rule.OriginalOutputsJson, out var splitDefinition);
        if (isSplitRule && splitDefinition is not null)
        {
            splitType = splitDefinition.Type;
            splitLines.AddRange(splitDefinition.Lines.Select(x => new QuickBooksSplitLine
            {
                CategoryName = x.CategoryName,
                Value = x.Value,
                IsRemainder = x.IsRemainder
            }));
        }

        loadedReadOnlyImport = rule.IsReadOnlyImport && !isSplitRule;

        conditions.Clear();
        conditions.AddRange(rule.Conditions.Select(x => new RuleCondition
        {
            Field = x.Field,
            Operator = x.Operator,
            Value = x.Value
        }));

        if (conditions.Count == 0)
            conditions.Add(NewCondition());

        message = null;
        isError = false;
        showCreateAnotherPrompt = false;
    }

    private void ResetForm()
    {
        ruleName = string.Empty;
        direction = RuleDirection.MoneyOut;
        transactionType = RuleTransactionType.Expense;
        categoryId = string.Empty;
        payee = string.Empty;
        conditionLogic = "all";
        autoAdd = false;
        message = null;
        isError = false;
        showCreateAnotherPrompt = false;
        loadedReadOnlyImport = false;
        isSplitRule = false;
        splitType = QuickBooksSplitType.Percentage;
        splitLines.Clear();

        conditions.Clear();
        conditions.Add(NewCondition());
    }

    private void CreateAnother()
    {
        ResetForm();
        Navigation.NavigateTo("/rules/new", replace: true);
    }

    private void ReturnToRules() => Navigation.NavigateTo("/rules");

    private void AddCondition() => conditions.Add(NewCondition());

    private void RemoveCondition(int index)
    {
        if (conditions.Count > 1 && index >= 0 && index < conditions.Count)
            conditions.RemoveAt(index);
    }

    private void SplitRuleChanged(ChangeEventArgs e)
    {
        isSplitRule = e.Value is bool value && value;

        if (isSplitRule)
        {
            direction = RuleDirection.MoneyOut;
            transactionType = RuleTransactionType.Expense;
            categoryId = string.Empty;
            payee = string.Empty;
            autoAdd = false;

            if (splitLines.Count < 2)
            {
                splitLines.Clear();
                splitLines.Add(new QuickBooksSplitLine());
                splitLines.Add(new QuickBooksSplitLine());
            }
        }
    }

    private void SplitTypeChanged(ChangeEventArgs e)
    {
        if (!Enum.TryParse<QuickBooksSplitType>(e.Value?.ToString(), out var parsed))
            return;

        splitType = parsed;

        foreach (var line in splitLines)
        {
            line.IsRemainder = false;
            if (splitType == QuickBooksSplitType.Percentage && string.IsNullOrWhiteSpace(line.Value))
                line.Value = string.Empty;
        }

        if (splitType == QuickBooksSplitType.Amount && splitLines.Count > 0)
        {
            splitLines[^1].IsRemainder = true;
            splitLines[^1].Value = string.Empty;
        }
    }

    private void AddSplitLine() => splitLines.Add(new QuickBooksSplitLine());

    private void RemoveSplitLine(int index)
    {
        if (splitLines.Count > 2 && index >= 0 && index < splitLines.Count)
            splitLines.RemoveAt(index);
    }

    private void SplitRemainderChanged(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= splitLines.Count)
            return;

        var isRemainder = e.Value is bool value && value;

        if (isRemainder)
        {
            foreach (var line in splitLines)
                line.IsRemainder = false;

            splitLines[index].IsRemainder = true;
            splitLines[index].Value = string.Empty;
        }
        else
        {
            splitLines[index].IsRemainder = false;
        }
    }

    private IEnumerable<string> SplitCategoryOptions(QuickBooksSplitLine line)
    {
        var names = categories
            .Where(x => x.IsActive)
            .Select(x => x.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(line.CategoryName))
            names.Add(line.CategoryName);

        return names.OrderBy(x => x, StringComparer.OrdinalIgnoreCase);
    }

    private QuickBooksSplitDefinition BuildSplitDefinition() => new()
    {
        Type = splitType,
        Lines = splitLines.Select(x => new QuickBooksSplitLine
        {
            CategoryName = x.CategoryName.Trim(),
            Value = x.Value.Trim(),
            IsRemainder = x.IsRemainder
        }).ToList()
    };

    private void DirectionChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<RuleDirection>(e.Value?.ToString(), out var parsed))
        {
            direction = parsed;
            if (!AllowedTransactionTypes.Contains(transactionType))
                transactionType = AllowedTransactionTypes[0];
        }
    }

    private void ConditionFieldChanged(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= conditions.Count)
            return;

        if (Enum.TryParse<RuleMatchField>(e.Value?.ToString(), out var parsed))
        {
            conditions[index].Field = parsed;
            conditions[index].Operator = MasterRulePolicy.GetAllowedOperators(parsed)[0];
        }
    }

    private async Task SaveAsync()
    {
        if (loadedReadOnlyImport)
        {
            SetError("This imported QuickBooks rule is preserved exactly for export and cannot be edited yet.");
            return;
        }

        var name = ruleName.Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            SetError("Rule name is required.");
            return;
        }

        if (conditions.Count == 0 || conditions.Any(x => string.IsNullOrWhiteSpace(x.Value)))
        {
            SetError("Every rule needs at least one condition with a value.");
            return;
        }

        if (!MasterRulePolicy.CanCreate(direction, transactionType))
        {
            SetError("That transaction type is not valid for the selected money direction.");
            return;
        }

        QuickBooksSplitDefinition? splitDefinition = null;

        if (isSplitRule)
        {
            if (direction != RuleDirection.MoneyOut || transactionType != RuleTransactionType.Expense)
            {
                SetError("Split rules are currently verified only for Money out / Expense.");
                return;
            }

            splitDefinition = BuildSplitDefinition();
            var splitError = QuickBooksSplitRuleCodec.Validate(splitDefinition);
            if (splitError is not null)
            {
                SetError(splitError);
                return;
            }
        }

        Guid? selectedCategoryId = null;
        string? selectedCategoryName = null;

        if (!isSplitRule && !string.IsNullOrWhiteSpace(categoryId))
        {
            if (!Guid.TryParse(categoryId, out var parsedCategoryId))
            {
                SetError("The selected category is invalid.");
                return;
            }

            selectedCategoryId = parsedCategoryId;
            selectedCategoryName = categories.FirstOrDefault(x => x.Id == parsedCategoryId)?.Name;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        MasterRule entity;
        var isNew = !RuleId.HasValue;

        if (RuleId.HasValue)
        {
            entity = await db.MasterRules.SingleAsync(x => x.Id == RuleId.Value);
        }
        else
        {
            entity = new MasterRule
            {
                OrganizationId = organizationId
            };
            db.MasterRules.Add(entity);
        }

        entity.Name = name;
        entity.Direction = direction;
        entity.TransactionType = transactionType;
        entity.CategoryId = isSplitRule ? null : selectedCategoryId;
        entity.CategoryName = isSplitRule ? null : selectedCategoryName;
        entity.Payee = isSplitRule ? null : NullIfWhiteSpace(payee);
        entity.MatchAllConditions = conditionLogic == "all";
        entity.AutoAdd = isSplitRule ? false : autoAdd;
        entity.IsAccountSpecific = false;
        entity.IsReadOnlyImport = false;
        entity.OriginalOutputsJson = isSplitRule && splitDefinition is not null
            ? QuickBooksSplitRuleCodec.Serialize(splitDefinition)
            : null;
        entity.Conditions = conditions.Select(x => new RuleCondition
        {
            Field = x.Field,
            Operator = x.Operator,
            Value = x.Value.Trim()
        }).ToList();
        entity.ModifiedUtc = DateTime.UtcNow;

        await db.SaveChangesAsync();

        if (isNew)
        {
            showCreateAnotherPrompt = true;
            message = null;
            isError = false;
        }
        else
        {
            Navigation.NavigateTo("/rules");
        }
    }

    private void SetError(string text)
    {
        isError = true;
        message = text;
    }

    private static RuleCondition NewCondition() => new()
    {
        Field = RuleMatchField.BankText,
        Operator = RuleMatchOperator.Contains,
        Value = string.Empty
    };

    private static string? NullIfWhiteSpace(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string FormatTransactionType(RuleTransactionType type) => type switch
    {
        RuleTransactionType.CreditCardPayment => "Credit card payment",
        _ => string.Concat(type.ToString().Select((c, i) => i > 0 && char.IsUpper(c) ? " " + c : c.ToString()))
    };

    private static string FormatOperator(RuleMatchOperator op) => op switch
    {
        RuleMatchOperator.DoesNotContain => "Doesn't contain",
        RuleMatchOperator.DoesNotEqual => "Doesn't equal",
        RuleMatchOperator.StartsWith => "Starts with",
        RuleMatchOperator.EndsWith => "Ends with",
        RuleMatchOperator.GreaterThan => "Is greater than",
        RuleMatchOperator.LessThan => "Is less than",
        _ => op.ToString()
    };
}
