@page "/categories"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using RuleManager.Core.Domain
@using RuleManager.Data
@using RuleManager.Data.Services
@inject IDbContextFactory<RuleManagerDbContext> DbFactory
@inject WorkspaceService Workspace

<PageTitle>Categories</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Categories</h1>
        <p class="text-muted mb-0">QuickBooks categories discovered from imported bank rules, plus explicit local overrides.</p>
    </div>
    <button class="btn btn-outline-primary" @onclick="ToggleOverride">Add Category Override</button>
</div>

<div class="alert alert-info">
    <strong>Recommended:</strong> create or rename categories in QuickBooks first, then import a bank-rule file that uses them.
    That lets RuleManager learn the exact QBO category name automatically.
</div>

@if (showOverride)
{
    <div class="alert alert-warning">
        <strong>Category override:</strong> this does not create a category in QuickBooks.
        The category must already exist in QBO and the name must match exactly.
        QuickBooks may require manual mapping during rule import, so double-check the resulting rule after import.
        <div class="row g-2 mt-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label">Exact QuickBooks category name</label>
                <input class="form-control" @bind="overrideCategoryName" placeholder="Example: Auto:Insurance" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button class="btn btn-warning" @onclick="AddOverrideAsync">Add Override</button>
                <button class="btn btn-outline-secondary" @onclick="ToggleOverride">Cancel</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
}

<div class="card">
    <div class="card-body p-0">
        @if (categories.Count == 0)
        {
            <div class="p-4 text-muted">No categories have been discovered from QuickBooks imports yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Main Category</th>
                            <th>Subcategory</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in categories)
                        {
                            <tr>
                                <td><strong>@category.Name</strong></td>
                                <td>@category.MainCategory</td>
                                <td>@(category.SubCategory ?? "—")</td>
                                <td>
                                    <span class="badge @(category.IsActive ? "status-badge-active" : "status-badge-inactive")">
                                        @(category.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleActiveAsync(category)">
                                        @(category.IsActive ? "Hide from RuleManager" : "Show in RuleManager")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private readonly List<Category> categories = new();
    private Guid organizationId;
    private bool showOverride;
    private string overrideCategoryName = string.Empty;
    private string? message;
    private bool isError;

    protected override async Task OnInitializedAsync()
    {
        organizationId = await Workspace.GetOrCreateDefaultOrganizationIdAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        categories.Clear();
        categories.AddRange(await db.Categories
            .Where(x => x.OrganizationId == organizationId)
            .OrderByDescending(x => x.IsActive)
            .ThenBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());
    }

    private void ToggleOverride()
    {
        showOverride = !showOverride;
        overrideCategoryName = string.Empty;
        message = null;
        isError = false;
    }

    private async Task AddOverrideAsync()
    {
        string normalized;
        try
        {
            normalized = CategoryName.Normalize(overrideCategoryName);
        }
        catch (ArgumentException ex)
        {
            isError = true;
            message = ex.Message;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var existing = await db.Categories.FirstOrDefaultAsync(x =>
            x.OrganizationId == organizationId &&
            x.Name.ToLower() == normalized.ToLower());

        if (existing is null)
        {
            db.Categories.Add(new Category
            {
                OrganizationId = organizationId,
                Name = normalized
            });
        }
        else
        {
            existing.IsActive = true;
            existing.ModifiedUtc = DateTime.UtcNow;
        }

        await db.SaveChangesAsync();
        await LoadAsync();

        showOverride = false;
        overrideCategoryName = string.Empty;
        isError = false;
        message = $"Category override '{normalized}' added. Confirm this exact category already exists in QuickBooks before exporting or importing rules that use it.";
    }

    private async Task ToggleActiveAsync(Category category)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Categories.SingleAsync(x => x.Id == category.Id);
        entity.IsActive = !entity.IsActive;
        entity.ModifiedUtc = DateTime.UtcNow;
        await db.SaveChangesAsync();
        await LoadAsync();
    }
}
