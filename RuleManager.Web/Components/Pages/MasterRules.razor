@page "/rules"
@page "/master-rules"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using RuleManager.Core.Domain
@using RuleManager.Data
@using RuleManager.Data.Services
@inject IDbContextFactory<RuleManagerDbContext> DbFactory
@inject WorkspaceService Workspace
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Rules</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Rules</h1>
        <p class="text-muted mb-0">Search, filter, edit, deactivate, or assign reusable rules.</p>
    </div>
    <button class="btn btn-primary" @onclick="CreateRule">New Rule</button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
}

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-lg-4">
                <label class="form-label">Search</label>
                <input class="form-control"
                       @bind="searchText"
                       @bind:event="oninput"
                       placeholder="Rule name, category, payee, or condition..." />
            </div>

            <div class="col-md-3 col-lg-2">
                <label class="form-label">Status</label>
                <select class="form-select" @bind="statusFilter">
                    <option value="all">All</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>

            <div class="col-md-3 col-lg-2">
                <label class="form-label">Direction</label>
                <select class="form-select" @bind="directionFilter">
                    <option value="all">All</option>
                    <option value="out">Money out</option>
                    <option value="in">Money in</option>
                </select>
            </div>

            <div class="col-md-3 col-lg-2">
                <label class="form-label">Transaction</label>
                <select class="form-select" @bind="transactionFilter">
                    <option value="all">All</option>
                    @foreach (var type in Enum.GetValues<RuleTransactionType>())
                    {
                        <option value="@type">@FormatTransactionType(type)</option>
                    }
                </select>
            </div>

            <div class="col-md-3 col-lg-2">
                <label class="form-label">Category</label>
                <select class="form-select" @bind="categoryFilter">
                    <option value="all">All</option>
                    <option value="none">No category</option>
                    @foreach (var category in categoryNames)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted small">
                Showing @FilteredRules.Count() of @rules.Count rule(s)
            </div>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">Clear Filters</button>
        </div>
    </div>
</div>

@if (batchRule is not null)
{
    <div class="card mb-4 border-primary">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="card-title mb-1">Assign "@batchRule.Name" Directly</h5>
                    <div class="text-muted">Find a client by name or choose one from the dropdown.</div>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseBatchAssign">Close</button>
            </div>

            @if (activeClients.Count == 0)
            {
                <div class="text-muted">No active clients are available.</div>
            }
            else
            {
                <div class="row g-3 align-items-end">
                    <div class="col-lg-5">
                        <label class="form-label">Find client</label>
                        <input class="form-control"
                               @bind="clientSearchText"
                               @bind:event="oninput"
                               placeholder="Start typing a client name..." />
                    </div>

                    <div class="col-lg-5">
                        <label class="form-label">Client</label>
                        <select class="form-select" @bind="selectedDirectClientId">
                            <option value="">-- Select client --</option>
                            @foreach (var client in DirectClientOptions)
                            {
                                <option value="@client.Id">
                                    @client.Name@(directAssignedClientIds.Contains(client.Id) ? " — already assigned directly" : "")
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-2">
                        <button class="btn btn-primary w-100" @onclick="AssignDirectToClientAsync">
                            Assign
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(clientSearchText) && !DirectClientOptions.Any())
                {
                    <div class="text-muted small mt-2">No active clients match that name.</div>
                }

                <div class="form-text mt-2">
                    Direct assignment is intended for one-off client needs. Rules used broadly should be added to a Rule Set.
                </div>
            }
        </div>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        @if (!FilteredRules.Any())
        {
            <div class="p-4 text-muted">
                @(rules.Count == 0 ? "No rules have been created yet." : "No rules match the current search and filters.")
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Rule</th>
                            <th>Direction</th>
                            <th>Conditions</th>
                            <th>Transaction Type</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th class="text-end" style="min-width: 360px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in FilteredRules)
                        {
                            <tr>
                                <td>
                                    <strong>@rule.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(rule.Payee))
                                    {
                                        <div class="small text-muted">Payee: @rule.Payee</div>
                                    }
                                </td>
                                <td>@(rule.Direction == RuleDirection.MoneyOut ? "Money out" : "Money in")</td>
                                <td>
                                    <div>@(rule.MatchAllConditions ? "All" : "Any")</div>
                                    <div class="small text-muted">@rule.Conditions.Count condition(s)</div>
                                </td>
                                <td>@FormatTransactionType(rule.TransactionType)</td>
                                <td>@(rule.CategoryName ?? "—")</td>
                                <td>
                                    <span class="badge @(rule.IsActive ? "status-badge-active" : "status-badge-inactive")">
                                        @(rule.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex align-items-center justify-content-end gap-2 flex-nowrap rule-actions">
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => OpenBatchAssignAsync(rule)">Assign Directly</button>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditRule(rule.Id)">Edit</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleActiveAsync(rule)">
                                            @(rule.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRuleAsync(rule)">Delete</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private Guid organizationId;
    private readonly List<MasterRule> rules = new();
    private readonly List<string> categoryNames = new();

    private string searchText = string.Empty;
    private string statusFilter = "all";
    private string directionFilter = "all";
    private string transactionFilter = "all";
    private string categoryFilter = "all";
    private string? message;
    private bool isError;

    private MasterRule? batchRule;
    private readonly List<Client> activeClients = new();
    private readonly HashSet<Guid> directAssignedClientIds = new();
    private string clientSearchText = string.Empty;
    private string selectedDirectClientId = string.Empty;

    private IEnumerable<MasterRule> FilteredRules => rules.Where(rule =>
        MatchesSearch(rule) &&
        MatchesStatus(rule) &&
        MatchesDirection(rule) &&
        MatchesTransaction(rule) &&
        MatchesCategory(rule));

    private IEnumerable<Client> DirectClientOptions =>
        activeClients.Where(client =>
            string.IsNullOrWhiteSpace(clientSearchText)
            || client.Name.Contains(clientSearchText.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        organizationId = await Workspace.GetOrCreateDefaultOrganizationIdAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        rules.Clear();
        rules.AddRange(await db.MasterRules
            .Where(x => x.OrganizationId == organizationId)
            .OrderByDescending(x => x.IsActive)
            .ThenBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());

        categoryNames.Clear();
        categoryNames.AddRange(rules
            .Select(x => x.CategoryName)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x));
    }

    private bool MatchesSearch(MasterRule rule)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return true;

        var term = searchText.Trim();

        return rule.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (rule.CategoryName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (rule.Payee?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || rule.Conditions.Any(x => x.Value.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private bool MatchesStatus(MasterRule rule) => statusFilter switch
    {
        "active" => rule.IsActive,
        "inactive" => !rule.IsActive,
        _ => true
    };

    private bool MatchesDirection(MasterRule rule) => directionFilter switch
    {
        "out" => rule.Direction == RuleDirection.MoneyOut,
        "in" => rule.Direction == RuleDirection.MoneyIn,
        _ => true
    };

    private bool MatchesTransaction(MasterRule rule) =>
        transactionFilter == "all"
        || rule.TransactionType.ToString() == transactionFilter;

    private bool MatchesCategory(MasterRule rule) => categoryFilter switch
    {
        "all" => true,
        "none" => string.IsNullOrWhiteSpace(rule.CategoryName),
        _ => string.Equals(rule.CategoryName, categoryFilter, StringComparison.OrdinalIgnoreCase)
    };

    private void ClearFilters()
    {
        searchText = string.Empty;
        statusFilter = "all";
        directionFilter = "all";
        transactionFilter = "all";
        categoryFilter = "all";
    }

    private void CreateRule() => Navigation.NavigateTo("/rules/new");

    private void EditRule(Guid ruleId) => Navigation.NavigateTo($"/rules/{ruleId}/edit");

    private async Task OpenBatchAssignAsync(MasterRule rule)
    {
        batchRule = rule;
        clientSearchText = string.Empty;
        selectedDirectClientId = string.Empty;
        directAssignedClientIds.Clear();

        await using var db = await DbFactory.CreateDbContextAsync();

        activeClients.Clear();
        activeClients.AddRange(await db.Clients
            .Where(x => x.OrganizationId == organizationId && x.IsActive)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());

        var directlyAssignedIds = await db.ClientRuleAssignments
            .Where(x => x.MasterRuleId == rule.Id && x.IsExplicit)
            .Select(x => x.ClientId)
            .ToListAsync();

        foreach (var id in directlyAssignedIds)
            directAssignedClientIds.Add(id);
    }

    private void CloseBatchAssign()
    {
        batchRule = null;
        activeClients.Clear();
        directAssignedClientIds.Clear();
        clientSearchText = string.Empty;
        selectedDirectClientId = string.Empty;
    }

    private async Task AssignDirectToClientAsync()
    {
        if (batchRule is null)
            return;

        Guid clientId;

        if (Guid.TryParse(selectedDirectClientId, out var selectedId))
        {
            clientId = selectedId;
        }
        else
        {
            var matches = DirectClientOptions.ToList();

            if (matches.Count != 1)
            {
                message = matches.Count == 0
                    ? "Enter a client name or select a client from the dropdown."
                    : "More than one client matches. Select the client you want from the dropdown.";
                isError = true;
                return;
            }

            clientId = matches[0].Id;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var assignment = await db.ClientRuleAssignments
            .SingleOrDefaultAsync(x => x.ClientId == clientId && x.MasterRuleId == batchRule.Id);

        if (assignment is null)
        {
            db.ClientRuleAssignments.Add(new ClientRuleAssignment
            {
                ClientId = clientId,
                MasterRuleId = batchRule.Id,
                Status = RuleAssignmentStatus.Inherited,
                IsExplicit = true
            });

            await db.SaveChangesAsync();
        }
        else if (!assignment.IsExplicit)
        {
            assignment.IsExplicit = true;
            assignment.ModifiedUtc = DateTime.UtcNow;
            await db.SaveChangesAsync();
        }
        else
        {
            message = "That rule is already assigned directly to this client.";
            isError = true;
            return;
        }

        var clientName = activeClients.First(x => x.Id == clientId).Name;
        message = $"Rule assigned directly to {clientName}.";
        isError = false;
        await OpenBatchAssignAsync(batchRule);
    }

    private async Task ToggleActiveAsync(MasterRule rule)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.MasterRules.SingleAsync(x => x.Id == rule.Id);
        entity.IsActive = !entity.IsActive;
        entity.ModifiedUtc = DateTime.UtcNow;
        await db.SaveChangesAsync();

        message = entity.IsActive ? "Rule activated." : "Rule deactivated.";
        isError = false;
        await LoadAsync();
    }

    private async Task DeleteRuleAsync(MasterRule rule)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var clientAssignmentCount = await db.ClientRuleAssignments
            .CountAsync(x => x.MasterRuleId == rule.Id);

        var ruleSetCount = await db.RuleSetRules
            .CountAsync(x => x.MasterRuleId == rule.Id);

        var clientRuleReferenceCount = await db.ClientRules
            .CountAsync(x => x.SourceMasterRuleId == rule.Id);

        if (clientAssignmentCount > 0 || ruleSetCount > 0 || clientRuleReferenceCount > 0)
        {
            var references = new List<string>();

            if (ruleSetCount > 0)
                references.Add($"{ruleSetCount} Rule Set(s)");

            if (clientAssignmentCount > 0)
                references.Add($"{clientAssignmentCount} client assignment(s)");

            if (clientRuleReferenceCount > 0)
                references.Add($"{clientRuleReferenceCount} client-specific rule reference(s)");

            message = $"'{rule.Name}' cannot be deleted because it is still referenced by {string.Join(", ", references)}. Remove those references first, or deactivate the rule instead.";
            isError = true;
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Delete '{rule.Name}' permanently? This cannot be undone.");

        if (!confirmed)
            return;

        var entity = await db.MasterRules
            .SingleOrDefaultAsync(x => x.Id == rule.Id && x.OrganizationId == organizationId);

        if (entity is null)
        {
            message = "The rule no longer exists.";
            isError = true;
            await LoadAsync();
            return;
        }

        db.MasterRules.Remove(entity);
        await db.SaveChangesAsync();

        if (batchRule?.Id == rule.Id)
            CloseBatchAssign();

        message = $"Rule '{rule.Name}' deleted.";
        isError = false;
        await LoadAsync();
    }

    private static string FormatTransactionType(RuleTransactionType type) => type switch
    {
        RuleTransactionType.CreditCardPayment => "Credit card payment",
        _ => string.Concat(type.ToString().Select((c, i) => i > 0 && char.IsUpper(c) ? " " + c : c.ToString()))
    };
}
