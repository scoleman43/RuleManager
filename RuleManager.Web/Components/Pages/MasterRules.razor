@page "/rules"
@page "/master-rules"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using RuleManager.Core.Domain
@using RuleManager.Data
@using RuleManager.Data.Services
@inject IDbContextFactory<RuleManagerDbContext> DbFactory
@inject WorkspaceService Workspace
@inject NavigationManager Navigation

<PageTitle>Rules</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Rules</h1>
        <p class="text-muted mb-0">Search, filter, edit, deactivate, or assign reusable rules.</p>
    </div>
    <button class="btn btn-primary" @onclick="CreateRule">New Rule</button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-success">@message</div>
}

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-lg-4">
                <label class="form-label">Search</label>
                <input class="form-control"
                       @bind="searchText"
                       @bind:event="oninput"
                       placeholder="Rule name, category, payee, or condition..." />
            </div>

            <div class="col-md-3 col-lg-2">
                <label class="form-label">Status</label>
                <select class="form-select" @bind="statusFilter">
                    <option value="all">All</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>

            <div class="col-md-3 col-lg-2">
                <label class="form-label">Direction</label>
                <select class="form-select" @bind="directionFilter">
                    <option value="all">All</option>
                    <option value="out">Money out</option>
                    <option value="in">Money in</option>
                </select>
            </div>

            <div class="col-md-3 col-lg-2">
                <label class="form-label">Transaction</label>
                <select class="form-select" @bind="transactionFilter">
                    <option value="all">All</option>
                    @foreach (var type in Enum.GetValues<RuleTransactionType>())
                    {
                        <option value="@type">@FormatTransactionType(type)</option>
                    }
                </select>
            </div>

            <div class="col-md-3 col-lg-2">
                <label class="form-label">Category</label>
                <select class="form-select" @bind="categoryFilter">
                    <option value="all">All</option>
                    <option value="none">No category</option>
                    @foreach (var category in categoryNames)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted small">
                Showing @FilteredRules.Count() of @rules.Count rule(s)
            </div>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">Clear Filters</button>
        </div>
    </div>
</div>

@if (batchRule is not null)
{
    <div class="card mb-4 border-primary">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="card-title mb-1">Assign "@batchRule.Name" Directly</h5>
                    <div class="text-muted">Use direct assignment for one-off client needs. Rule Set membership is managed separately.</div>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseBatchAssign">Close</button>
            </div>

            <div class="d-flex gap-2 mb-3">
                <button class="btn btn-primary" @onclick="AssignBatchToAllActiveAsync">Assign Directly to All Active Clients</button>
                <button class="btn btn-outline-primary" @onclick="AssignBatchToSelectedAsync" disabled="@(selectedClientIds.Count == 0)">
                    Assign Directly to Selected (@selectedClientIds.Count)
                </button>
            </div>

            @if (activeClients.Count == 0)
            {
                <div class="text-muted">No active clients are available.</div>
            }
            else
            {
                <div class="row g-2">
                    @foreach (var client in activeClients)
                    {
                        var clientId = client.Id;
                        var alreadyAssigned = batchAssignedClientIds.Contains(clientId);

                        <div class="col-md-6 col-lg-4">
                            <div class="border rounded p-2">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           checked="@selectedClientIds.Contains(clientId)"
                                           disabled="@alreadyAssigned"
                                           @onchange="e => ToggleSelectedClient(clientId, e)" />
                                    <label class="form-check-label">
                                        @client.Name
                                        @if (alreadyAssigned)
                                        {
                                            <span class="badge text-bg-success ms-1">Assigned</span>
                                        }
                                    </label>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        @if (!FilteredRules.Any())
        {
            <div class="p-4 text-muted">
                @(rules.Count == 0 ? "No rules have been created yet." : "No rules match the current search and filters.")
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Rule</th>
                            <th>Direction</th>
                            <th>Conditions</th>
                            <th>Transaction Type</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in FilteredRules)
                        {
                            <tr>
                                <td>
                                    <strong>@rule.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(rule.Payee))
                                    {
                                        <div class="small text-muted">Payee: @rule.Payee</div>
                                    }
                                </td>
                                <td>@(rule.Direction == RuleDirection.MoneyOut ? "Money out" : "Money in")</td>
                                <td>
                                    <div>@(rule.MatchAllConditions ? "All" : "Any")</div>
                                    <div class="small text-muted">@rule.Conditions.Count condition(s)</div>
                                </td>
                                <td>@FormatTransactionType(rule.TransactionType)</td>
                                <td>@(rule.CategoryName ?? "—")</td>
                                <td>
                                    <span class="badge @(rule.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                        @(rule.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-success me-2" @onclick="() => OpenBatchAssignAsync(rule)">Assign Directly</button>
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => EditRule(rule.Id)">Edit</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleActiveAsync(rule)">
                                        @(rule.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private Guid organizationId;
    private readonly List<MasterRule> rules = new();
    private readonly List<string> categoryNames = new();

    private string searchText = string.Empty;
    private string statusFilter = "all";
    private string directionFilter = "all";
    private string transactionFilter = "all";
    private string categoryFilter = "all";
    private string? message;

    private MasterRule? batchRule;
    private readonly List<Client> activeClients = new();
    private readonly HashSet<Guid> selectedClientIds = new();
    private readonly HashSet<Guid> batchAssignedClientIds = new();

    private IEnumerable<MasterRule> FilteredRules => rules.Where(rule =>
        MatchesSearch(rule) &&
        MatchesStatus(rule) &&
        MatchesDirection(rule) &&
        MatchesTransaction(rule) &&
        MatchesCategory(rule));

    protected override async Task OnInitializedAsync()
    {
        organizationId = await Workspace.GetOrCreateDefaultOrganizationIdAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        rules.Clear();
        rules.AddRange(await db.MasterRules
            .Where(x => x.OrganizationId == organizationId)
            .OrderByDescending(x => x.IsActive)
            .ThenBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());

        categoryNames.Clear();
        categoryNames.AddRange(rules
            .Select(x => x.CategoryName)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x));
    }

    private bool MatchesSearch(MasterRule rule)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return true;

        var term = searchText.Trim();

        return rule.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (rule.CategoryName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (rule.Payee?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || rule.Conditions.Any(x => x.Value.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private bool MatchesStatus(MasterRule rule) => statusFilter switch
    {
        "active" => rule.IsActive,
        "inactive" => !rule.IsActive,
        _ => true
    };

    private bool MatchesDirection(MasterRule rule) => directionFilter switch
    {
        "out" => rule.Direction == RuleDirection.MoneyOut,
        "in" => rule.Direction == RuleDirection.MoneyIn,
        _ => true
    };

    private bool MatchesTransaction(MasterRule rule) =>
        transactionFilter == "all"
        || rule.TransactionType.ToString() == transactionFilter;

    private bool MatchesCategory(MasterRule rule) => categoryFilter switch
    {
        "all" => true,
        "none" => string.IsNullOrWhiteSpace(rule.CategoryName),
        _ => string.Equals(rule.CategoryName, categoryFilter, StringComparison.OrdinalIgnoreCase)
    };

    private void ClearFilters()
    {
        searchText = string.Empty;
        statusFilter = "all";
        directionFilter = "all";
        transactionFilter = "all";
        categoryFilter = "all";
    }

    private void CreateRule() => Navigation.NavigateTo("/rules/new");

    private void EditRule(Guid ruleId) => Navigation.NavigateTo($"/rules/{ruleId}/edit");

    private async Task OpenBatchAssignAsync(MasterRule rule)
    {
        batchRule = rule;
        selectedClientIds.Clear();
        batchAssignedClientIds.Clear();

        await using var db = await DbFactory.CreateDbContextAsync();

        activeClients.Clear();
        activeClients.AddRange(await db.Clients
            .Where(x => x.OrganizationId == organizationId && x.IsActive)
            .OrderBy(x => x.Name)
            .AsNoTracking()
            .ToListAsync());

        var assignedIds = await db.ClientRuleAssignments
            .Where(x => x.MasterRuleId == rule.Id)
            .Select(x => x.ClientId)
            .ToListAsync();

        foreach (var id in assignedIds)
            batchAssignedClientIds.Add(id);
    }

    private void CloseBatchAssign()
    {
        batchRule = null;
        activeClients.Clear();
        selectedClientIds.Clear();
        batchAssignedClientIds.Clear();
    }

    private void ToggleSelectedClient(Guid clientId, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
            selectedClientIds.Add(clientId);
        else
            selectedClientIds.Remove(clientId);
    }

    private async Task AssignBatchToAllActiveAsync()
    {
        if (batchRule is null)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var assigned = await AssignRuleToClientsAsync(db, batchRule.Id, null);

        message = assigned == 0
            ? "All active clients already have this rule assigned."
            : $"Rule assigned directly to {assigned} additional active client(s).";

        await OpenBatchAssignAsync(batchRule);
    }

    private async Task AssignBatchToSelectedAsync()
    {
        if (batchRule is null || selectedClientIds.Count == 0)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var assigned = await AssignRuleToClientsAsync(db, batchRule.Id, selectedClientIds);

        message = assigned == 0
            ? "The selected clients already have this rule assigned."
            : $"Rule assigned directly to {assigned} selected client(s).";

        await OpenBatchAssignAsync(batchRule);
    }

    private async Task<int> AssignRuleToClientsAsync(
        RuleManagerDbContext db,
        Guid masterRuleId,
        IReadOnlyCollection<Guid>? selectedIds)
    {
        var clientQuery = db.Clients
            .Where(x => x.OrganizationId == organizationId && x.IsActive);

        if (selectedIds is not null)
            clientQuery = clientQuery.Where(x => selectedIds.Contains(x.Id));

        var clientIds = await clientQuery.Select(x => x.Id).ToListAsync();

        var existingAssignments = await db.ClientRuleAssignments
            .Where(x => x.MasterRuleId == masterRuleId && clientIds.Contains(x.ClientId))
            .ToListAsync();

        var existingByClient = existingAssignments.ToDictionary(x => x.ClientId);
        var changed = 0;

        foreach (var clientId in clientIds)
        {
            if (existingByClient.TryGetValue(clientId, out var existing))
            {
                if (!existing.IsExplicit)
                {
                    existing.IsExplicit = true;
                    existing.ModifiedUtc = DateTime.UtcNow;
                    changed++;
                }
                continue;
            }

            db.ClientRuleAssignments.Add(new ClientRuleAssignment
            {
                ClientId = clientId,
                MasterRuleId = masterRuleId,
                Status = RuleAssignmentStatus.Inherited,
                IsExplicit = true
            });
            changed++;
        }

        if (changed > 0)
            await db.SaveChangesAsync();

        return changed;
    }

    private async Task ToggleActiveAsync(MasterRule rule)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.MasterRules.SingleAsync(x => x.Id == rule.Id);
        entity.IsActive = !entity.IsActive;
        entity.ModifiedUtc = DateTime.UtcNow;
        await db.SaveChangesAsync();

        message = entity.IsActive ? "Rule activated." : "Rule deactivated.";
        await LoadAsync();
    }

    private static string FormatTransactionType(RuleTransactionType type) => type switch
    {
        RuleTransactionType.CreditCardPayment => "Credit card payment",
        _ => string.Concat(type.ToString().Select((c, i) => i > 0 && char.IsUpper(c) ? " " + c : c.ToString()))
    };
}
